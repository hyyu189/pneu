#!/usr/bin/env python3
"""Run the internal isolated Grok ACP pneu lab supervisor."""

from __future__ import annotations

import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
BIN = ROOT / "bin"
INSTALLED_SHARE = ROOT / "share" / "pneu"
for import_root in (BIN, INSTALLED_SHARE, ROOT):
    if import_root.is_dir() and str(import_root) not in sys.path:
        sys.path.insert(0, str(import_root))

from integrations.grok.roundtable import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
