#!/usr/bin/env python3
"""Wait for resolved project mail while keeping host-local wake state fenced.

The registry-pinned mailbox layout owns durable mail. Process identity,
activity, and heartbeat state belong to the currently
claimed host-local seat in ``RT_RUNTIME_DIR``.
"""

from __future__ import annotations

import hashlib
import json
import os
import signal
import sys
import time
from pathlib import Path

from _rtlib import (
    ProjectLayoutLockTimeout,
    ProjectRegistryError,
    is_project_root,
    locked_project_mailbox_checked,
    not_project_message,
)
from _rtruntime import (
    DEFAULT_HEARTBEAT_RENEWAL_INTERVAL,
    FenceRejected,
    RuntimeStateError,
    clear_wake,
    load_validated_lease,
    update_wake,
    watcher_is_live,
)


# The watcher is intentionally long-lived.  It scans mail at most every five
# seconds and renews the lease on every scan; this is comfortably below the
# ten-second renewal target and the 30-second health TTL in _rtruntime.
POLL_SECONDS = min(5.0, DEFAULT_HEARTBEAT_RENEWAL_INTERVAL)
LAYOUT_SCAN_TIMEOUT_SECONDS = 1.0
GENERATION_POLL_SECONDS = 0.25


class StopRequested(Exception):
    pass


def _managed_command_root() -> Path:
    configured = os.environ.get("ROUNDTABLE_INSTALL_PREFIX")
    if configured:
        prefix = Path(configured).expanduser()
        if prefix.is_absolute():
            return prefix / "bin"
    return Path(os.path.abspath(sys.argv[0])).parent


def _claude_drain_instructions(agent: str) -> str:
    command_root = _managed_command_root()
    return (
        "Roundtable mail arrived. Read and act on every pending message for "
        f"{agent!r}. Use these package-managed command paths exactly so the "
        "narrow setup permissions apply:\n"
        f"  {command_root / 'rt-inbox'} --fenced --archive-quiet-acks "
        "-f json\n"
        f"  {command_root / 'rt-ack'} --fenced <id>[,<id>...]\n"
        f"  {command_root / 'rt-say'} --fenced --no-nudge "
        "<agent> <kind> <body...>\n"
        "The Stop hook re-arms the inbox watcher automatically after this "
        "turn; do not start another watcher yourself."
    )


def _stop(_signum, _frame) -> None:
    raise StopRequested


def _project_at_or_above(start: Path) -> Path | None:
    current = start.expanduser().resolve()
    for candidate in (current, *current.parents):
        if is_project_root(candidate):
            return candidate
    return None


def _project_root() -> Path:
    configured = os.environ.get("RT_PROJECT_ROOT")
    discovered = _project_at_or_above(Path.cwd())
    if configured:
        project = Path(configured).expanduser().resolve()
        if not is_project_root(project):
            raise RuntimeStateError(
                f"RT_PROJECT_ROOT is not a Roundtable project: {project}"
            )
        if discovered is not None and discovered != project:
            raise RuntimeStateError(
                f"RT_PROJECT_ROOT {project} does not match cwd project {discovered}"
            )
        return project
    if discovered is None:
        raise RuntimeStateError(not_project_message("rt-wait-inbox"))
    return discovered


def _lease_environment(agent: str) -> tuple[str, str]:
    session_id = os.environ.get("RT_SESSION_ID")
    revision = os.environ.get("RT_LEASE_REVISION")
    missing = [
        name
        for name, value in (
            ("RT_SESSION_ID", session_id),
            ("RT_LEASE_REVISION", revision),
        )
        if not value
    ]
    if missing:
        raise RuntimeStateError(
            "missing claimed-seat environment: " + ", ".join(missing)
        )
    launched_as = os.environ.get("RT_FROM")
    if launched_as and launched_as != agent:
        raise RuntimeStateError(
            f"RT_FROM={launched_as!r} does not match requested agent {agent!r}"
        )
    return session_id, revision


def _wake_mail(new_dir: Path) -> list[str]:
    try:
        names = sorted(path.name for path in new_dir.iterdir())
    except FileNotFoundError:
        return []
    return [name for name in names if not name.startswith(("ack-", "."))]


def _ack_count(new_dir: Path) -> int:
    try:
        return sum(
            1
            for path in new_dir.iterdir()
            if path.name.startswith("ack-") and not path.name.startswith(".")
        )
    except FileNotFoundError:
        return 0


def _mailbox_snapshot(
    project: Path,
    agent: str,
    *,
    create: bool = False,
) -> tuple[list[str], int]:
    """Take one authoritative snapshot without retaining the lock over sleep."""

    with locked_project_mailbox_checked(
        project,
        timeout=LAYOUT_SCAN_TIMEOUT_SECONDS,
    ) as mailbox:
        inbox = mailbox.inbox_dir / agent
        new_dir = inbox / "new"
        if create:
            for path in (new_dir, inbox / "cur", inbox / "tmp"):
                path.mkdir(parents=True, exist_ok=True)
        return _wake_mail(new_dir), _ack_count(new_dir)


def _validated_generation(value: object) -> tuple[str, ...]:
    if not isinstance(value, (list, tuple)) or not value:
        raise RuntimeStateError("last wake generation is empty or invalid")
    names = []
    for item in value:
        if (
            not isinstance(item, str)
            or not item
            or len(item.encode("utf-8")) > 255
            or Path(item).name != item
            or item.startswith((".", "ack-"))
            or "/" in item
            or "\x00" in item
        ):
            raise RuntimeStateError(
                f"last wake generation contains an unsafe filename: {item!r}"
            )
        names.append(item)
    if len(set(names)) != len(names):
        raise RuntimeStateError("last wake generation contains duplicates")
    return tuple(names)


def _generation_pending(
    project: Path,
    agent: str,
    generation: tuple[str, ...],
) -> bool:
    with locked_project_mailbox_checked(
        project,
        timeout=LAYOUT_SCAN_TIMEOUT_SECONDS,
    ) as mailbox:
        new_dir = mailbox.inbox_dir / agent / "new"
        for name in generation:
            try:
                (new_dir / name).lstat()
            except FileNotFoundError:
                continue
            return True
        return False


def wait_last_wake_drained(agent: str) -> int:
    """Follow one exact generation across layout flips for a host adapter."""

    project = _project_root()
    session_id, revision = _lease_environment(agent)
    lease = load_validated_lease(project, agent, session_id, revision)
    generation = _validated_generation(lease.last_wake_messages)
    expected_generation = os.environ.get(
        "RT_EXPECTED_WAKE_GENERATION", ""
    ).strip()
    actual_generation = hashlib.sha256(
        "\n".join(generation).encode("utf-8")
    ).hexdigest()
    if expected_generation and expected_generation != actual_generation:
        raise RuntimeStateError(
            "last wake generation changed before follower startup"
        )
    while True:
        # Revalidate the fence before every mailbox observation. A follower
        # never owns or updates the watcher heartbeat slot.
        load_validated_lease(project, agent, session_id, revision)
        try:
            pending = _generation_pending(project, agent, generation)
            load_validated_lease(project, agent, session_id, revision)
            if not pending:
                return 0
        except ProjectLayoutLockTimeout:
            # An exclusive migration is a transient pause, not a broken
            # Hermes installation or an invalid seat identity.
            pass
        time.sleep(GENERATION_POLL_SECONDS)


def _parse_minutes(raw: str | None) -> int | None:
    if raw is None:
        return None
    try:
        value = int(raw)
    except ValueError as error:
        raise RuntimeStateError(f"max-minutes must be a non-negative integer: {raw}") from error
    if value < 0:
        raise RuntimeStateError(f"max-minutes must be a non-negative integer: {raw}")
    return value


def _stop_hook_retry_exhausted(
    pending_at_stop: list[str],
    lease,
    *,
    enabled: bool,
) -> bool:
    return (
        enabled
        and tuple(pending_at_stop) == lease.last_wake_messages
        and lease.wake_attempts >= 2
    )


def _report_stop_hook_retry_exhausted() -> None:
    print(
        "rt-wait-inbox: the same Roundtable mail generation is still "
        "pending after one Stop-hook retry; automatic re-wake is paused "
        "to prevent a loop. "
        "The mail remains durable in new/. Resolve any /permissions or "
        "command error, then interact with this Claude session to retry.",
        file=sys.stderr,
    )


def run(
    agent: str,
    explicit_minutes: int | None,
    *,
    claude_hook: bool = False,
    claude_stop_hook: bool = False,
    stop_hook_active: bool = False,
) -> int:
    # ``max-minutes`` remains accepted for launcher compatibility, but an
    # armed watcher no longer expires merely because the inbox stayed empty.
    del explicit_minutes
    project = _project_root()
    session_id, revision = _lease_environment(agent)
    # Validate before touching either the durable inbox or host-local runtime.
    lease = load_validated_lease(project, agent, session_id, revision)
    # SessionStart also fires after compaction. If the original async Claude
    # hook is still healthy, the duplicate hook must quietly stand down rather
    # than replacing it or spuriously waking Claude with a fence error.
    if claude_hook and watcher_is_live(lease):
        return 0

    while True:
        try:
            pending_at_stop, _initial_acks = _mailbox_snapshot(
                project,
                agent,
                create=True,
            )
            break
        except ProjectLayoutLockTimeout:
            # Migration holds EX only for its bounded cutover. Keep the fence
            # live, but do not classify normal quiescence as a broken watcher.
            load_validated_lease(
                project, agent, session_id, revision
            )
            time.sleep(GENERATION_POLL_SECONDS)
    # A migration may have queued more than one hook before any could scan.
    # Refresh the generation/attempt state, and let a winner that registered
    # while we waited suppress this duplicate before evaluating the breaker.
    lease = load_validated_lease(
        project, agent, session_id, revision
    )
    if claude_hook and watcher_is_live(lease):
        return 0
    stop_breaker_enabled = claude_stop_hook and stop_hook_active
    if _stop_hook_retry_exhausted(
        pending_at_stop,
        lease,
        enabled=stop_breaker_enabled,
    ):
        _report_stop_hook_retry_exhausted()
        return 0

    watcher_pid = os.getpid()
    try:
        try:
            token = update_wake(
                project,
                agent,
                session_id,
                revision,
                watcher_pid=watcher_pid,
            )
        except FenceRejected:
            if claude_hook and watcher_is_live(
                load_validated_lease(project, agent, session_id, revision)
            ):
                return 0
            raise
        # The watcher claim is the linearization point between queued hooks.
        # A predecessor can advance wakeAttempts and release its slot after
        # our pre-claim refresh, so re-evaluate the breaker against the exact
        # token returned by the successful claim before recording another
        # attempt.
        if _stop_hook_retry_exhausted(
            pending_at_stop,
            token,
            enabled=stop_breaker_enabled,
        ):
            _report_stop_hook_retry_exhausted()
            return 0
        mail = pending_at_stop
        waited_seconds = 0
        superseded = False

        while not mail:
            time.sleep(POLL_SECONDS)
            waited_seconds += POLL_SECONDS
            try:
                token = update_wake(
                    project,
                    agent,
                    session_id,
                    revision,
                    expected_watcher_pid=watcher_pid,
                )
            except FenceRejected:
                superseded = True
                break
            try:
                candidate_mail, _candidate_acks = (
                    _mailbox_snapshot(project, agent, create=True)
                )
            except ProjectLayoutLockTimeout:
                # Do not count an exclusive migration as an empty heartbeat.
                continue
            mail = candidate_mail

        if superseded:
            print("rt-wait-inbox: seat lease or watcher was superseded")
            return 0
        if mail:
            prior_messages = token.last_wake_messages
            attempts = (
                token.wake_attempts + 1
                if tuple(mail) == prior_messages
                else 1
            )
            token = update_wake(
                project,
                agent,
                session_id,
                revision,
                last_wake_messages=mail,
                wake_attempts=attempts,
                expected_watcher_pid=watcher_pid,
            )
            print(f"rt-wait-inbox: mail after {waited_seconds:g}s:")
            print("\n".join(mail))
            if claude_hook:
                print(_claude_drain_instructions(agent), file=sys.stderr)
        try:
            _remaining_mail, acks = _mailbox_snapshot(
                project,
                agent,
                create=True,
            )
        except ProjectLayoutLockTimeout:
            acks = 0
        if acks:
            print(
                f"rt-wait-inbox: {acks} quiet ack file(s) pending in new/ "
                "— drain to cur/ while you're awake"
            )
        # Claude Code's asyncRewake contract wakes an idle session only when
        # the background hook exits 2. Ordinary terminal/Hermes watchers keep
        # their success exit after a mail generation; an empty inbox never
        # reaches this point because the watcher renews silently in place.
        return 2 if claude_hook else 0
    except StopRequested:
        return 0
    finally:
        try:
            clear_wake(
                project,
                agent,
                session_id,
                revision,
                expected_watcher_pid=watcher_pid,
            )
        except (FenceRejected, RuntimeStateError):
            # A superseded watcher must never clear its successor's wake state.
            pass


def _claude_hook_is_managed() -> bool:
    """Return whether a global Claude hook belongs to a claimed RT session.

    The hook is installed in user-level settings and therefore fires for every
    Claude project. A normal direct Claude launch must remain a silent no-op.
    Partial lease context is deliberately treated as managed so ``run`` can
    fail closed and surface the broken launch environment.
    """

    return any(
        os.environ.get(name)
        for name in (
            "RT_PROJECT_ROOT",
            "RT_FROM",
            "RT_SESSION_ID",
            "RT_LEASE_REVISION",
        )
    )


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    follow_generation = bool(
        argv and argv[0] == "--wait-last-wake-drained"
    )
    if follow_generation:
        argv.pop(0)
        if len(argv) != 1:
            print(
                "usage: rt-wait-inbox --wait-last-wake-drained <agent>",
                file=sys.stderr,
            )
            return 2
    claude_stop_hook = bool(argv and argv[0] == "--claude-stop-hook")
    claude_hook = bool(
        argv and argv[0] in ("--claude-hook", "--claude-stop-hook")
    )
    stop_hook_active = False
    if claude_hook:
        argv.pop(0)
        if not _claude_hook_is_managed():
            return 0
        if claude_stop_hook:
            try:
                hook_input = json.load(sys.stdin)
                if not isinstance(hook_input, dict):
                    raise ValueError("hook input must be an object")
                stop_hook_active = hook_input.get("stop_hook_active") is True
            except (OSError, ValueError, json.JSONDecodeError) as error:
                print(
                    "rt-wait-inbox: invalid Claude Stop hook input; refusing "
                    f"automatic re-wake to avoid a loop: {error}",
                    file=sys.stderr,
                )
                return 0
        if not argv:
            launched_as = os.environ.get("RT_FROM", "").strip()
            if launched_as:
                argv.append(launched_as)
    if not 1 <= len(argv) <= 2:
        print(
            "usage: rt-wait-inbox [--claude-hook|--claude-stop-hook] "
            "<agent> [legacy-max-minutes]",
            file=sys.stderr,
        )
        return 2
    try:
        if follow_generation:
            return wait_last_wake_drained(argv[0])
        explicit = _parse_minutes(argv[1] if len(argv) == 2 else None)
        return run(
            argv[0],
            explicit,
            claude_hook=claude_hook,
            claude_stop_hook=claude_stop_hook,
            stop_hook_active=stop_hook_active,
        )
    except FenceRejected:
        print("rt-wait-inbox: seat lease or watcher was superseded")
        return 0 if follow_generation else 2
    except (ProjectRegistryError, RuntimeStateError, OSError) as error:
        message = str(error)
        if not message.startswith("rt-wait-inbox: "):
            message = f"rt-wait-inbox: {message}"
        print(message, file=sys.stderr)
        return 2


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)
    raise SystemExit(main())
