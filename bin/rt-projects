#!/usr/bin/env python3
"""Maintain the Roundtable project registry."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

from _rtmigrate import (
    migrate_project,
    rollback_project,
)
from _rtlib import (
    ProjectRegistryError,
    emit_registry_warnings,
    load_project_registry,
    projects_registry_path,
    register_project,
    resolve_project_mailbox,
    unregister_project,
    upgrade_project_registry,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="rt-projects")
    parser.add_argument(
        "--registry",
        type=Path,
        default=projects_registry_path(),
        help="registry path (default: ~/.pneu/projects.yaml)",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("list", help="list registry rows and diagnostics")
    subparsers.add_parser(
        "upgrade",
        help="explicitly back up and upgrade a v1 registry to v2",
    )
    add = subparsers.add_parser("add", help="register one project")
    add.add_argument("root", type=Path)
    resolve = subparsers.add_parser(
        "resolve",
        help="print the UUID-pinned mailbox as diagnostic JSON",
    )
    resolve.add_argument("root", type=Path)
    remove = subparsers.add_parser("rm", help="tombstone one project")
    remove.add_argument("root", type=Path)
    migrate = subparsers.add_parser(
        "migrate",
        help="copy one local mailbox into the central UUID store",
    )
    migrate.add_argument("root", type=Path)
    migrate.add_argument(
        "--backup-dir",
        type=Path,
        help="private migration backup root",
    )
    migrate.add_argument(
        "--layout-lock-timeout",
        type=float,
        default=10.0,
        help=(
            "maximum seconds to acquire each layout lock; normal exclusive "
            "migration admission is capped at five seconds"
        ),
    )
    migrate.add_argument(
        "--registry-lock-timeout",
        type=float,
        default=10.0,
        help=(
            "maximum registry wait; normal migration further caps it to the "
            "remaining five-second hold budget"
        ),
    )
    migrate.add_argument(
        "--confirm-quiesced",
        action="store_true",
        help=(
            "confirm every project seat and mailbox command is stopped and "
            "permit bypassing normal migration admission/hold budgets"
        ),
    )
    rollback = subparsers.add_parser(
        "rollback",
        help="copy current central mail back to local using an exact manifest",
    )
    rollback.add_argument("root", type=Path)
    rollback.add_argument("--manifest", type=Path, required=True)
    rollback.add_argument(
        "--backup-dir",
        type=Path,
        help="private rollback backup root",
    )
    rollback.add_argument(
        "--layout-lock-timeout",
        type=float,
        default=10.0,
        help=(
            "maximum seconds to acquire each layout lock; normal exclusive "
            "migration admission is capped at five seconds"
        ),
    )
    rollback.add_argument(
        "--registry-lock-timeout",
        type=float,
        default=10.0,
        help=(
            "maximum registry wait; normal migration further caps it to the "
            "remaining five-second hold budget"
        ),
    )
    rollback.add_argument(
        "--confirm-quiesced",
        action="store_true",
        help=(
            "confirm every project seat and mailbox command is stopped and "
            "permit bypassing normal migration admission/hold budgets"
        ),
    )
    return parser


def reclaim_codex_binding(root: Path) -> str | None:
    """Release a tombstoned project's Codex thread binding.

    ``pneu worktree remove`` already unbinds before retiring a tree.  A bare
    registry removal must do the same, or the bridge keeps a binding for a
    project the registry no longer routes to, and a later re-registration of
    the same path inherits a thread it never launched.  A failure here is
    advisory: the registry row is already tombstoned and the binding stays
    inert until the bridge is repaired.
    """

    command = Path(__file__).resolve().with_name("rt-codex-wake")
    if not command.is_file():
        return None
    try:
        result = subprocess.run(
            [str(command), "unbind", str(root)],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as error:
        return f"rt-projects: could not unbind Codex for {root}: {error}"
    if result.returncode == 0:
        return f"rt-projects: released the Codex thread binding for {root}"
    detail = (result.stderr or result.stdout).strip()
    if result.returncode == 1 and "not bound" in detail.lower():
        return None
    return (
        f"rt-projects: warning: could not unbind Codex for {root} "
        f"(exit {result.returncode})" + (f": {detail}" if detail else "")
    )


def print_transition_summary(result: dict) -> None:
    operation = result.get("operation")
    if operation not in {"migrate", "rollback"}:
        return
    verb = "migrated" if operation == "migrate" else "rolled back"
    manifest = (
        result.get("rollback_manifest")
        if operation == "rollback"
        else result.get("manifest")
    ) or result.get("manifest")
    print(
        f"{verb}: {result.get('files', 0)} files, "
        f"{result.get('bytes', 0)} bytes; manifest at {manifest}",
        file=sys.stderr,
    )


def main() -> int:
    args = build_parser().parse_args()
    if args.command == "list":
        entries, warnings = load_project_registry(args.registry)
        emit_registry_warnings(warnings, tool="rt-projects")
        for entry in entries:
            registered_at = entry.get("registered_at") or "unknown"
            project_uuid = entry.get("uuid") or "legacy"
            status = entry.get("status") or "active"
            layout = entry.get("layout") or "local"
            print(
                f"{entry['root']}\t{registered_at}\t{project_uuid}\t"
                f"{status}\t{layout}"
            )
        return 0
    if args.command == "upgrade":
        changed = upgrade_project_registry(args.registry)
        print(f"{'upgraded' if changed else 'already current'} {args.registry}")
        return 0
    if args.command == "add":
        changed = register_project(args.root, args.registry)
        root = args.root.expanduser().resolve()
        print(f"{'added' if changed else 'already registered'} {root}")
        return 0
    if args.command == "resolve":
        mailbox = resolve_project_mailbox(
            args.root,
            registry_path=args.registry,
        )
        print(
            json.dumps(
                {
                    "uuid": mailbox.project_uuid,
                    "project_root": str(mailbox.project_root),
                    "layout": mailbox.layout,
                    "state_dir": str(mailbox.state_dir),
                    "mail_root": str(mailbox.mail_root),
                    "inbox_dir": str(mailbox.inbox_dir),
                    "messages_dir": str(mailbox.messages_dir),
                    "locks_dir": str(mailbox.locks_dir),
                    "layout_lock": str(mailbox.layout_lock),
                },
                sort_keys=True,
            )
        )
        return 0
    if args.command in {"migrate", "rollback"}:
        try:
            if args.command == "migrate":
                result = migrate_project(
                    args.root,
                    registry_path=args.registry,
                    backup_root=args.backup_dir,
                    layout_lock_timeout=args.layout_lock_timeout,
                    registry_lock_timeout=args.registry_lock_timeout,
                    confirm_quiesced=args.confirm_quiesced,
                )
            else:
                result = rollback_project(
                    args.root,
                    args.manifest,
                    registry_path=args.registry,
                    backup_root=args.backup_dir,
                    layout_lock_timeout=args.layout_lock_timeout,
                    registry_lock_timeout=args.registry_lock_timeout,
                    confirm_quiesced=args.confirm_quiesced,
                )
        except ProjectRegistryError as error:
            raise SystemExit(
                f"rt-projects: {args.command} failed: {error}"
            ) from None
        for warning in result.get("warnings", []):
            print(f"rt-projects: warning: {warning}", file=sys.stderr)
        print_transition_summary(result)
        print(json.dumps(result, sort_keys=True))
        return 0
    changed = unregister_project(args.root, args.registry)
    root = args.root.expanduser().resolve()
    print(f"{'tombstoned' if changed else 'not registered'} {root}")
    if changed:
        reclaimed = reclaim_codex_binding(root)
        if reclaimed is not None:
            print(reclaimed, file=sys.stderr)
    return 0 if changed else 1


if __name__ == "__main__":
    raise SystemExit(main())
