#!/usr/bin/env python3
"""Own one project's Claude Remote Control worktree server."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

from _rtrchost import (
    RCHostError,
    disable,
    enable,
    require_enabled,
    status,
)
from _rtlib import (
    ProjectRegistryError,
    active_project_entries,
    find_project_root,
    load_project_registry_strict,
    resolve_project_mailbox_checked,
)


MAX_HOOK_INPUT_BYTES = 64 * 1024


def _hook_payload(stdin) -> dict:
    raw = stdin.read(MAX_HOOK_INPUT_BYTES + 1)
    if len(raw.encode("utf-8")) > MAX_HOOK_INPUT_BYTES:
        raise RCHostError("hook input exceeds 64 KiB")
    try:
        value = json.loads(raw)
    except (TypeError, json.JSONDecodeError) as error:
        raise RCHostError(f"hook input is not valid JSON: {error}") from error
    if not isinstance(value, dict):
        raise RCHostError("hook input must be a JSON object")
    return value


def _payload_project(payload: dict, event: str) -> Path:
    if payload.get("hook_event_name") != event:
        raise RCHostError(
            f"expected {event} hook input, got {payload.get('hook_event_name')!r}"
        )
    raw = payload.get("cwd")
    if not isinstance(raw, str) or not raw or "\0" in raw:
        raise RCHostError("hook input cwd is missing or invalid")
    try:
        cwd = Path(raw).expanduser().resolve(strict=True)
    except (OSError, RuntimeError, ValueError) as error:
        raise RCHostError(f"hook input cwd cannot be resolved: {error}") from error
    return resolve_project_mailbox_checked(cwd).project_root


def _run_worktree(arguments: list[str], *, cwd: Path) -> subprocess.CompletedProcess[str]:
    command = Path(__file__).resolve().with_name("rt-worktree")
    if not command.is_file() or not os.access(command, os.X_OK):
        raise RCHostError(f"managed rt-worktree is unavailable: {command}")
    try:
        return subprocess.run(
            [str(command), *arguments],
            cwd=cwd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as error:
        raise RCHostError(f"cannot run managed worktree command: {error}") from error


def hook_create(stdin, stdout, stderr) -> int:
    payload = _hook_payload(stdin)
    session_project = _payload_project(payload, "WorktreeCreate")
    state = require_enabled(session_project)
    project = Path(state["projectRoot"])
    name = payload.get("name")
    if not isinstance(name, str) or not name or "\0" in name:
        raise RCHostError("WorktreeCreate name is missing or invalid")
    result = _run_worktree(
        ["add", name, "--yes", "--porcelain-path"],
        cwd=project,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        print(
            "pneu rc-host: WorktreeCreate failed; "
            f"{detail}; remedy: resolve the named conflict, then retry from {project}",
            file=stderr,
        )
        return 2
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(lines) != 1:
        print(
            "pneu rc-host: WorktreeCreate produced no unique worktree path; "
            "remedy: run `pneu worktree list` and inspect the managed hook",
            file=stderr,
        )
        return 2
    path = Path(lines[0])
    try:
        resolved = path.resolve(strict=True)
        resolve_project_mailbox_checked(resolved)
    except (OSError, RuntimeError, ValueError, ProjectRegistryError) as error:
        print(
            f"pneu rc-host: WorktreeCreate returned an unusable path: {error}; "
            "remedy: inspect `pneu worktree list`",
            file=stderr,
        )
        return 2
    print(resolved, file=stdout)
    return 0


def _target_entry(anchor: Path, target: Path) -> dict:
    anchor_mailbox = resolve_project_mailbox_checked(anchor)
    entries, _warnings = load_project_registry_strict()
    anchor_entry = next(
        (
            item
            for item in active_project_entries(entries, available_only=True)
            if item.get("uuid") == anchor_mailbox.project_uuid
        ),
        None,
    )
    matches = [
        item
        for item in active_project_entries(entries, available_only=True)
        if Path(item.get("root", "")).expanduser().resolve() == target
    ]
    if not isinstance(anchor_entry, dict) or len(matches) != 1:
        raise RCHostError(f"cannot resolve one registered worktree for removal: {target}")
    entry = matches[0]
    if entry.get("group") != anchor_entry.get("group"):
        raise RCHostError(f"refusing worktree outside the enabled repository group: {target}")
    return entry


def hook_remove(stdin, stderr) -> int:
    payload = _hook_payload(stdin)
    session_project = _payload_project(payload, "WorktreeRemove")
    state = require_enabled(session_project)
    project = Path(state["projectRoot"])
    raw = payload.get("worktree_path")
    if not isinstance(raw, str) or not raw or "\0" in raw:
        raise RCHostError("WorktreeRemove worktree_path is missing or invalid")
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute() or candidate.is_symlink():
        raise RCHostError("WorktreeRemove path must be an absolute non-symlink path")
    try:
        target = candidate.resolve(strict=True)
    except (OSError, RuntimeError, ValueError) as error:
        raise RCHostError(f"WorktreeRemove path cannot be resolved: {error}") from error
    entry = _target_entry(project, target)
    result = _run_worktree(["remove", str(entry["name"]), "--yes"], cwd=project)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        print(
            "pneu rc-host: worktree removal deferred by the fail-closed pneu path; "
            f"{detail}; the worktree remains at {target}",
            file=stderr,
        )
        return 0
    if result.stderr.strip():
        print(result.stderr.strip(), file=stderr)
    return 0


def _status_payload(value) -> dict:
    return {
        "schema": "roundtable.rc-host-status.v1",
        "project": str(value.project),
        "project_uuid": value.project_uuid,
        "label": value.label,
        "enabled": value.enabled,
        "configured": value.configured,
        "loaded": value.loaded,
        "pid": value.pid,
        "process_alive": value.process_alive,
        "healthy": value.healthy,
        "last_registration": value.last_registration,
        "detail": value.detail,
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pneu rc-host")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("enable", help="enable this project's Claude phone host")
    subparsers.add_parser("disable", help="disable this project's Claude phone host")
    status_parser = subparsers.add_parser("status", help="inspect this project's phone host")
    status_parser.add_argument("--json", action="store_true")
    return parser


def main(argv: list[str] | None = None, *, stdin=None, stdout=None, stderr=None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    internal = raw_argv[0] if len(raw_argv) == 1 and raw_argv[0] in {
        "hook-create",
        "hook-remove",
    } else None
    args = None if internal else build_parser().parse_args(raw_argv)
    command = internal or args.command
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    stderr = sys.stderr if stderr is None else stderr
    try:
        if command == "hook-create":
            return hook_create(stdin, stdout, stderr)
        if command == "hook-remove":
            return hook_remove(stdin, stderr)
        project = find_project_root("rt-rc-host", allow_cmux_workspace=False)
        if command == "enable":
            value = enable(project)
        elif command == "disable":
            value = disable(project)
        else:
            value = status(project)
        payload = _status_payload(value)
        if args is not None and getattr(args, "json", False):
            print(json.dumps(payload, indent=2, sort_keys=True), file=stdout)
        else:
            state = "on" if value.enabled else "off"
            health = "healthy" if value.healthy else value.detail
            print(f"Claude phone connection: {state} — {health}", file=stdout)
            if value.last_registration:
                print(
                    "last registration: "
                    f"{value.last_registration.get('at')} "
                    f"{value.last_registration.get('agent')}@"
                    f"{value.last_registration.get('projectRoot')}",
                    file=stdout,
                )
        return 0 if not value.enabled or value.healthy else 2
    except (RCHostError, ProjectRegistryError, OSError) as error:
        print(f"pneu rc-host: {error}", file=stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
