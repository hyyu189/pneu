#!/usr/bin/env python3
import argparse
import json
import os
import re
import stat
import sys
from datetime import datetime, timezone
from pathlib import Path

from _rtlib import (
    LIFECYCLE_ORDINAL,
    MailEnvelopeError,
    ProjectRegistryError,
    current_records,
    find_project_root,
    load_agents_doc,
    load_project_registry_strict,
    locked_project_mailbox,
    parse_mail_envelope,
    parse_message_id,
    read_records,
    require_fenced_seat,
)

ROOT = find_project_root("rt-inbox")
MSG_DIR = None
INBOX_DIR = None
PROJECT_UUID = None
AGENT_COMPONENT_RE = re.compile(r"^[a-z0-9#_-]+$")
MALFORMED_SCHEMA = "roundtable.maildir_malformed.v1"
def parse_args():
    parser = argparse.ArgumentParser(prog="rt-inbox")
    parser.add_argument("agent", nargs="?", help="agent or instance to inspect; defaults to inferred sender")
    parser.add_argument("--all", action="store_true", help="include acked messages")
    parser.add_argument(
        "--fenced",
        action="store_true",
        help="require the current Roundtable launcher lease",
    )
    parser.add_argument(
        "--archive-quiet-acks",
        action="store_true",
        help="archive validated quiet acknowledgements for the fenced seat",
    )
    parser.add_argument("-f", "--format", choices=("text", "json"), default="text")
    return parser.parse_args()


def infer_agent_from_codex_thread():
    thread_id = os.environ.get("CODEX_THREAD_ID")
    if not thread_id:
        return ""
    document = load_agents_doc(ROOT, "rt-inbox")
    exact = []
    candidates = []
    for base, raw_config in (document.get("agents") or {}).items():
        config = raw_config if isinstance(raw_config, dict) else {}
        if str(config.get("harness") or base).lower() != "codex":
            continue
        base_name = str(base).lower()
        instances = config.get("instances") or [{"id": base_name}]
        for instance in instances:
            if isinstance(instance, str):
                instance_id = instance.lower()
                session_id = None
            else:
                instance_id = str((instance or {}).get("id") or base_name).lower()
                session_id = (instance or {}).get("session_id")
            candidates.append(instance_id)
            if session_id == thread_id:
                exact.append(instance_id)
    if len(exact) == 1:
        return exact[0]
    return candidates[0] if len(candidates) == 1 else ""


def infer_agent():
    env_from = os.environ.get("RT_FROM", "")
    if env_from:
        return env_from.lower()
    codex_agent = infer_agent_from_codex_thread()
    if codex_agent:
        return codex_agent
    raise SystemExit("rt-inbox: could not infer agent; pass agent or set RT_FROM")


def one_line(value):
    return re.sub(r"\s+", " ", str(value or "")).strip()


def truncate(value, width=80):
    text = one_line(value)
    if len(text) <= width:
        return text
    return text[: width - 3] + "..."


def refs_from_record(record):
    refs = list(record.get("refs") or [])
    if refs:
        return refs
    for part in one_line(record.get("body", "")).split():
        if part.startswith("refs="):
            return [ref for ref in part.removeprefix("refs=").split(",") if ref]
    return []


def mail_timestamp(msg_id, path):
    timestamp = msg_id.split("-", 1)[0]
    try:
        parsed = datetime.strptime(timestamp, "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        # A stray may be a dangling symlink or vanish mid-listing; a missing
        # mtime must not crash the listing that is meant to expose it.
        try:
            parsed = datetime.fromtimestamp(path.lstat().st_mtime, timezone.utc)
        except OSError:
            parsed = datetime.now(timezone.utc)
    return parsed.isoformat(timespec="milliseconds").replace("+00:00", "Z")


def malformed_record(
    target,
    folder,
    path,
    problem,
    content,
    sender="",
    origin_uuid=None,
):
    """Describe one undeliverable mail file instead of silently dropping it.

    The raw file stem is the id the user acknowledges when the remedy is
    rt-ack; a stray without the .md suffix keeps its full file name because
    no ack id can address it. The mailbox directory is the addressee, because
    the header itself cannot be trusted.
    """
    return {
        "schema": MALFORMED_SCHEMA,
        "msg_id": path.stem if path.suffix == ".md" else path.name,
        "event_id": "",
        "ts": mail_timestamp(path.stem, path),
        "from": sender,
        "to": target,
        "kind": "malformed",
        "problem": problem,
        "body": one_line(content),
        "rendered_text": content,
        "send_text": None,
        "workspace_ref": None,
        "surface_ref": None,
        "pane_ref": None,
        "submit": "none",
        "lifecycle": folder,
        "refs": [],
        "correlation": {},
        "source": "maildir",
        "origin_uuid": origin_uuid,
        "target_project_uuid": PROJECT_UUID,
        "maildir_path": str(path),
        "delivery_sources": ["maildir"],
    }


def stray_record(target, path):
    """Surface one wake-counted new/ entry that is not even a .md mail file."""
    try:
        stray_stat = path.lstat()
    except OSError:
        stray_stat = None
    if stray_stat is None or not stat.S_ISREG(stray_stat.st_mode):
        return malformed_record(target, "new", path, "not a regular mail file", "")
    try:
        content = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        content = ""
    return malformed_record(target, "new", path, "not a .md mail file", content)


def read_maildir_records():
    records = []
    if not INBOX_DIR.is_dir():
        return records
    for target_dir in sorted(INBOX_DIR.iterdir()):
        if not target_dir.is_dir() or not AGENT_COMPONENT_RE.fullmatch(target_dir.name):
            continue
        target = target_dir.name.lower()
        paths = []
        new_dir = target_dir / "new"
        if new_dir.is_dir():
            # Mirror rt-wait-inbox's wake predicate exactly: every name in
            # new/ that does not start with "ack-" or "." wakes the seat, so
            # each of them must surface here even when it is not a .md mail
            # file at all. Quiet acks and dot-hidden delivery temp files
            # never wake and stay hidden.
            for path in sorted(new_dir.iterdir()):
                name = path.name
                if name.startswith("."):
                    continue
                if name.endswith(".md"):
                    paths.append(("new", path))
                elif not name.startswith("ack-"):
                    records.append(stray_record(target, path))
        cur_dir = target_dir / "cur"
        if cur_dir.is_dir():
            paths.extend(("cur", path) for path in sorted(cur_dir.glob("*.md")))
        for folder, path in paths:
            # A file in new/ that cannot be validated still wakes the seat, so
            # it must stay visible instead of silently vanishing from the
            # listing. Archived garbage in cur/ is inert and stays hidden.
            try:
                mail_stat = path.lstat()
            except OSError:
                mail_stat = None
            if mail_stat is None or not stat.S_ISREG(mail_stat.st_mode):
                # rt-ack archives only regular files, so a directory or
                # symlink with a mail name is malformed even when it parses.
                if folder == "new":
                    records.append(
                        malformed_record(
                            target, folder, path, "not a regular mail file", ""
                        )
                    )
                continue
            try:
                content = path.read_text(encoding="utf-8")
            except (OSError, UnicodeError):
                if folder == "new":
                    records.append(
                        malformed_record(
                            target, folder, path, "unreadable mail file", ""
                        )
                    )
                continue
            try:
                parsed = parse_mail_envelope(content)
            except MailEnvelopeError as error:
                if folder == "new":
                    records.append(
                        malformed_record(
                            target,
                            folder,
                            path,
                            f"invalid origin metadata: {error}",
                            content,
                        )
                    )
                continue
            if parsed is None:
                if folder == "new":
                    records.append(
                        malformed_record(
                            target, folder, path, "invalid mail header", content
                        )
                    )
                continue
            msg_id = parsed["msg_id"]
            to_agent = parsed["to"]
            kind = parsed["kind"]
            origin_uuid = parsed.get("origin_uuid")
            # Drained normal mail is no longer inbox-visible. Drained quiet acks
            # remain fact-source tombstones: without the retired rt-watch there
            # is no separate process to materialize an "acked" ledger event.
            if folder == "cur" and kind != "sync-ack":
                continue
            valid_stems = {msg_id}
            if kind == "sync-ack":
                valid_stems.add(f"ack-{msg_id}")
            if path.stem not in valid_stems:
                if folder == "new":
                    records.append(
                        malformed_record(
                            target,
                            folder,
                            path,
                            "filename does not match message id",
                            content,
                            sender=parsed["from"],
                            origin_uuid=origin_uuid,
                        )
                    )
                continue
            if to_agent != target:
                if folder == "new":
                    records.append(
                        malformed_record(
                            target,
                            folder,
                            path,
                            "recipient does not match mailbox",
                            content,
                            sender=parsed["from"],
                            origin_uuid=origin_uuid,
                        )
                    )
                continue
            encoded_identity = parse_message_id(
                msg_id,
                recipient=parsed["to"],
            )
            if origin_uuid is not None and (
                encoded_identity is None
                or encoded_identity != (parsed["from"], parsed["to"])
            ):
                if folder == "new":
                    records.append(
                        malformed_record(
                            target,
                            folder,
                            path,
                            "message id identity does not match envelope",
                            content,
                            sender=parsed["from"],
                            origin_uuid=origin_uuid,
                        )
                    )
                continue
            body = parsed["body"]
            record = {
                "schema": "roundtable.maildir_message.v1",
                "msg_id": msg_id,
                "event_id": "",
                "ts": mail_timestamp(msg_id, path),
                "from": parsed["from"],
                "to": to_agent,
                "kind": kind,
                "body": body,
                "rendered_text": content,
                "send_text": None,
                "workspace_ref": None,
                "surface_ref": None,
                "pane_ref": None,
                "submit": "none",
                "lifecycle": folder,
                "refs": [],
                "correlation": {},
                "source": "maildir",
                "origin_uuid": parsed.get("origin_uuid"),
                "target_project_uuid": PROJECT_UUID,
                "maildir_path": str(path),
                "delivery_sources": ["maildir"],
            }
            if record["kind"] == "sync-ack":
                record["refs"] = refs_from_record(record)
            records.append(record)
    return records


def _fsync_directory(path):
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def archive_quiet_acks(agent):
    inbox = INBOX_DIR / agent
    new_dir = inbox / "new"
    cur_dir = inbox / "cur"
    for directory in (INBOX_DIR, inbox, new_dir):
        if directory.is_symlink():
            raise SystemExit(f"rt-inbox: maildir path is a symlink: {directory}")
        if directory.exists() and not directory.is_dir():
            raise SystemExit(
                f"rt-inbox: maildir path is not a directory: {directory}"
            )
    if not new_dir.exists():
        return 0
    cur_dir.mkdir(parents=True, exist_ok=True)
    if cur_dir.is_symlink() or not cur_dir.is_dir():
        raise SystemExit(f"rt-inbox: invalid archive directory: {cur_dir}")

    candidates = [
        Path(record["maildir_path"])
        for record in read_maildir_records()
        if record.get("to") == agent
        and record.get("kind") == "sync-ack"
        and Path(record.get("maildir_path", "")).parent == new_dir
    ]
    archived = 0
    for source in candidates:
        destination = cur_dir / source.name
        try:
            source_info = source.lstat()
            if not stat.S_ISREG(source_info.st_mode):
                raise OSError(f"quiet acknowledgement is not a regular file: {source}")
            try:
                destination_info = destination.lstat()
            except FileNotFoundError:
                destination_info = None
            if destination_info is None:
                os.link(source, destination, follow_symlinks=False)
                _fsync_directory(cur_dir)
            elif (
                not stat.S_ISREG(destination_info.st_mode)
                or (source_info.st_dev, source_info.st_ino)
                != (destination_info.st_dev, destination_info.st_ino)
            ):
                raise FileExistsError(
                    f"refusing to overwrite quiet acknowledgement archive: "
                    f"{destination}"
                )
            source.unlink()
            _fsync_directory(new_dir)
            archived += 1
        except OSError as error:
            raise SystemExit(
                f"rt-inbox: failed to archive quiet acknowledgement: {error}"
            ) from None
    return archived


def visible_records(agent, include_all):
    ledger_records = read_records(MSG_DIR)
    maildir_records = read_maildir_records()
    # The origin ledger also records cross-project deliveries, but those
    # lifecycle/ref namespaces belong to the target UUID. Isolate them before
    # folding by msg_id or deriving ack state so a rare id/ref collision cannot
    # hide or replace local mail.
    local_ledger_records = [
        record
        for record in ledger_records
        if (
            record.get("target_project_uuid") is None
            or record.get("target_project_uuid") == PROJECT_UUID
        )
    ]
    acked_refs = set()
    for record in local_ledger_records:
        if (
            record.get("msg_id")
            and LIFECYCLE_ORDINAL.get(record.get("lifecycle"), -1)
            >= LIFECYCLE_ORDINAL["acked"]
        ):
            acked_refs.add(record["msg_id"])
    for record in [*local_ledger_records, *maildir_records]:
        if record.get("kind") != "sync-ack":
            continue
        acked_refs.update(refs_from_record(record))

    records = []
    for ledger_record in current_records(local_ledger_records).values():
        record = dict(ledger_record)
        record["delivery_source"] = "ledger"
        record["delivery_sources"] = ["ledger"]
        records.append(record)
    for maildir_record in maildir_records:
        record = dict(maildir_record)
        record["delivery_source"] = "maildir"
        record["delivery_sources"] = ["maildir"]
        records.append(record)
    annotate_unackable(records)

    records.sort(
        key=lambda item: (
            item.get("ts", ""),
            item.get("msg_id", ""),
            item.get("delivery_source", ""),
        )
    )
    visible = []
    for record in records:
        if (record.get("to") or "").lower() != agent:
            continue
        if record.get("kind") == "sync-ack":
            continue
        if record.get("schema") == MALFORMED_SCHEMA or (
            record.get("lifecycle") == "new"
            and record.get("remedy") == "manual-move"
        ):
            # A malformed or permanently unackable record is a live file in
            # new/; it keeps waking this seat, so it stays listed as long as the
            # file exists regardless of acknowledgement bookkeeping.
            visible.append(record)
            continue
        if not include_all and record.get("msg_id") in acked_refs:
            continue
        if not include_all and LIFECYCLE_ORDINAL.get(record.get("lifecycle"), -1) >= LIFECYCLE_ORDINAL["acked"]:
            continue
        visible.append(record)
    return visible


def resolvable_instances(root=ROOT):
    """Mirror rt-say's configured-target resolution for remediation advice.

    An instance id resolves to itself; a base name resolves only when it has
    exactly one instance, because rt-say refuses an ambiguous base. When the
    agents document cannot be read, nothing resolves, so the advice degrades
    to the manual move that always works.
    """
    try:
        document = load_agents_doc(root, "rt-inbox")
        agents = document.get("agents") or {}
    except (Exception, SystemExit):
        return {}
    if not isinstance(agents, dict):
        return {}
    exact_counts = {}
    bases = []
    for base, raw_config in agents.items():
        if (
            not isinstance(base, str)
            or not AGENT_COMPONENT_RE.fullmatch(base)
            or not isinstance(raw_config, dict)
        ):
            return {}
        base_name = base
        instances = raw_config.get("instances")
        if instances is None or instances == []:
            instances = [{"id": base_name}]
        elif not isinstance(instances, list):
            return {}
        instance_names = []
        for instance in instances:
            if isinstance(instance, str):
                instance_name = instance
            elif isinstance(instance, dict):
                instance_name = instance.get("id")
            else:
                return {}
            if (
                not isinstance(instance_name, str)
                or not AGENT_COMPONENT_RE.fullmatch(instance_name)
            ):
                return {}
            instance_names.append(instance_name)
            exact_counts[instance_name] = (
                exact_counts.get(instance_name, 0) + 1
            )
        bases.append((base_name, instance_names))
    resolved = {
        instance_name: instance_name if count == 1 else None
        for instance_name, count in exact_counts.items()
    }
    for base_name, instance_names in bases:
        if base_name not in exact_counts:
            resolved[base_name] = (
                instance_names[0] if len(instance_names) == 1 else None
            )
    return resolved


def unackable_problem(record, registry_entries, instance_cache):
    """Explain UUID-aware mail that rt-ack cannot ever complete as-is."""

    if (
        record.get("schema") == MALFORMED_SCHEMA
        or record.get("lifecycle") != "new"
        or record.get("origin_uuid") is None
        or not record.get("maildir_path")
    ):
        return None

    path = Path(record["maildir_path"])
    archive = path.parent.parent / "cur" / path.name
    try:
        source_info = path.lstat()
    except OSError:
        return None
    try:
        archive_info = archive.lstat()
    except FileNotFoundError:
        archive_info = None
    except OSError:
        archive_info = None
    if archive_info is not None and (
        source_info.st_dev,
        source_info.st_ino,
    ) != (
        archive_info.st_dev,
        archive_info.st_ino,
    ):
        return f"conflicting new/cur copies for inbound ref {record['msg_id']}"

    origin_uuid = record["origin_uuid"]
    matches = [
        entry for entry in registry_entries if entry.get("uuid") == origin_uuid
    ]
    if not matches:
        return f"origin project {origin_uuid} is not registered"
    if len(matches) != 1:
        return (
            f"origin project {origin_uuid} has {len(matches)} registry entries"
        )
    origin = matches[0]
    if origin.get("status") != "active":
        return f"origin project {origin_uuid} is tombstoned"
    if not origin.get("available"):
        return (
            f"origin project {origin_uuid} is unavailable at {origin['root']}"
        )

    root = origin["root"]
    if root not in instance_cache:
        instance_cache[root] = resolvable_instances(root)
    sender = record.get("from")
    if instance_cache[root].get(sender) is None:
        return (
            f"origin project {origin_uuid} at {root} does not declare "
            f"acknowledgement target {sender!r}"
        )
    return None


def annotate_unackable(records):
    """Attach executable cleanup guidance to permanently unackable mail."""

    try:
        registry_entries, _warnings = load_project_registry_strict()
    except ProjectRegistryError:
        # A globally invalid registry is repairable host state, not proof that
        # any one message is permanently unackable.
        return []

    instance_cache = {}
    problems = []
    for record in records:
        problem = unackable_problem(
            record,
            registry_entries,
            instance_cache,
        )
        if problem is None:
            continue
        record["problem"] = problem
        record["remedy"] = "manual-move"
        problems.append((Path(record["maildir_path"]).name, problem))
    return sorted(problems)


def malformed_remedy(record, resolved):
    """Name the cleanup that actually breaks this record's wake loop.

    rt-ack is only advertised when every step it performs can succeed for
    this seat: a regular .md file, a parseable raw id, a raw-id recipient
    matching the mailbox owner, a registered non-self sender to receive the
    sync-ack, and a registered recipient identity to send it. Everything
    else needs the human to move the file out of new/ instead.
    """
    if record.get("problem") in {
        "not a regular mail file",
        "unreadable mail file",
    }:
        return "manual-move"
    if str(record.get("problem") or "").startswith(
        "invalid origin metadata:"
    ):
        return "manual-move"
    # UUID-aware mail is authoritative enough for rt-ack to verify every
    # identity field. If any such record reached the malformed path, rt-ack
    # will fail closed too, so never advertise it as an executable remedy.
    if record.get("origin_uuid") is not None:
        return "manual-move"
    path = Path(record.get("maildir_path", ""))
    if path.suffix != ".md":
        return "manual-move"
    identity = parse_message_id(
        path.stem,
        recipient=record.get("to"),
    )
    if identity is None:
        return "manual-move"
    ref_sender, ref_recipient = identity
    if ref_recipient != record.get("to"):
        return "manual-move"
    sender_instance = resolved.get(ref_sender)
    recipient_instance = resolved.get(ref_recipient)
    if not sender_instance or not recipient_instance:
        return "manual-move"
    if sender_instance == recipient_instance:
        return "manual-move"
    return "rt-ack"


def render_text(records):
    return "\n".join(
        f"{record.get('msg_id', '')}  "
        f"{record.get('from', '')}  "
        f"{record.get('kind', '')}  "
        f"{record.get('lifecycle', '')}  "
        f"[{'+'.join(record.get('delivery_sources') or ['ledger'])}]  "
        f"{truncate(record.get('body', ''))}"
        for record in records
    )


def _main_locked(args, fenced_agent):
    notices = []
    agent = (args.agent or fenced_agent or infer_agent()).lower()
    if fenced_agent and agent != fenced_agent:
        raise SystemExit(
            f"rt-inbox: fenced seat {fenced_agent} cannot inspect {agent}"
        )
    if args.archive_quiet_acks:
        archived = archive_quiet_acks(agent)
        if archived:
            notices.append(
                f"rt-inbox: archived {archived} quiet acknowledgement(s)",
            )
    records = visible_records(agent, args.all)
    unackable_by_file = {
        Path(record["maildir_path"]).name: record["problem"]
        for record in records
        if record.get("schema") != MALFORMED_SCHEMA
        and record.get("remedy") == "manual-move"
        and record.get("maildir_path")
    }
    unackable = sorted(unackable_by_file.items())
    malformed = [
        record for record in records if record.get("schema") == MALFORMED_SCHEMA
    ]
    if malformed:
        resolved = resolvable_instances()
        for record in malformed:
            record["remedy"] = malformed_remedy(record, resolved)
    if malformed:
        ackable = [
            record["msg_id"]
            for record in malformed
            if record["remedy"] == "rt-ack"
        ]
        # A manual move handles the file itself, so name the file, not an id.
        manual = [
            Path(record["maildir_path"]).name
            for record in malformed
            if record["remedy"] != "rt-ack"
        ]
        parts = [
            f"rt-inbox: {len(malformed)} malformed mail file(s) remain in "
            "new/ and keep waking this seat"
        ]
        if ackable:
            parts.append(
                "acknowledge with rt-ack (--fenced) <raw-id>: "
                + ", ".join(ackable)
            )
        if manual:
            parts.append(
                "rt-ack cannot archive these from this seat, so move each "
                "file out of new/ (for example into cur/) manually: "
                + ", ".join(manual)
            )
        notices.append("; ".join(parts))
    if unackable:
        details = ", ".join(
            f"{filename} ({problem})" for filename, problem in unackable
        )
        notices.append(
            f"rt-inbox: {len(unackable)} unackable UUID-aware mail file(s) "
            "remain in new/ and keep waking this seat; rt-ack cannot complete "
            "them, so move each file out of new/ (for example into cur/) "
            f"manually: {details}"
        )
    return records, args.format, notices


def main():
    global MSG_DIR, INBOX_DIR, PROJECT_UUID

    args = parse_args()
    if args.archive_quiet_acks and not args.fenced:
        raise SystemExit("rt-inbox: --archive-quiet-acks requires --fenced")
    # Fence validation uses the host-runtime state lock and must precede the
    # mailbox layout lock in the global acquisition order.
    fenced_agent = require_fenced_seat(ROOT, "rt-inbox") if args.fenced else ""
    with locked_project_mailbox(ROOT, tool="rt-inbox") as mailbox:
        MSG_DIR = mailbox.messages_dir
        INBOX_DIR = mailbox.inbox_dir
        PROJECT_UUID = mailbox.project_uuid
        records, output_format, notices = _main_locked(args, fenced_agent)
    output = (
        json.dumps(records, ensure_ascii=False, indent=2)
        if output_format == "json"
        else render_text(records)
    )
    if output:
        print(output)
    for notice in notices:
        print(notice, file=sys.stderr)


if __name__ == "__main__":
    main()
