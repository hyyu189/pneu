  codex      Launch a Codex seat
  grok       Launch a native Grok TUI seat with monitor activation
  send       Send a durable message
  inbox      Read a durable inbox
  ack        Acknowledge a durable message
  worktree   Add, open, list, or remove a registered Git worktree project
  rc-host    Enable, disable, or inspect this project's Claude phone host
"""

ASCII_GUIDE = """
+------------------------------------------------------------------+
| pneu = a local mailroom for coding-agent seats             |
+------------------------------------------------------------------+
| Claude Code       Codex       Hermes       Grok Build            |
|       \\            |           |             /                  |
|        +-----------+-----------+-------------+                   |
|                         |                                        |
|                         v                                        |
|                project mailbox: new/  ->  cur/                   |
|                         |                                        |
|                         v                                        |
|                the recipient agent works and acknowledges        |
+------------------------------------------------------------------+

Delivery and wake-up are separate:
  1. rt-say writes a durable message file. That is delivery.
  2. A live harness may notice the file and start a turn.
  3. The agent acts, then rt-ack archives the message.
  4. If the agent is offline, the message waits in new/.

Four selectable harnesses:
  Claude  SessionStart/Stop hooks arm and re-arm the tripwire.
  Hermes  the session-start plugin owns the tripwire lifecycle.
  Codex   the app-server and Unix-socket notification bridge wake the seat;
          the SessionStart hook binds the native thread to its lease.
  Grok Build runs its native TUI with a persistent mailbox monitor.

Tripwire means "watch for mail and request a harness-native turn".
It is not the mailbox and it is not keyboard injection.

Grok Build needs its vendor command installed. If it is missing, the launcher
names the command and tells you how to fix it.

Tip: run `pneu guide` any time to show this tutorial again.
""".lstrip()


class OnboardingError(RuntimeError):
    pass


def sibling(name: str) -> Path:
    target = Path(__file__).resolve().parent / name
    if target.is_file() and os.access(target, os.X_OK):
        return target
    fallback = shutil.which(name)
    if fallback:
        return Path(fallback).resolve()
    raise OnboardingError(f"pneu: installed command is unavailable: {target}")


def version_report() -> str:
    """Describe the version and installation selected by this executable."""

    configured_prefix = os.environ.get("ROUNDTABLE_INSTALL_PREFIX", "").strip()
    prefix = Path(configured_prefix).expanduser().resolve() if configured_prefix else None
    manifest = prefix / "install-manifest.json" if prefix is not None else None
    manifest_data = {}
    if manifest is not None:
        try:
            payload = json.loads(manifest.read_text())
            if isinstance(payload, dict):
                manifest_data = payload
        except (OSError, ValueError):
            manifest_data = {}

    version = manifest_data.get("version")
    if not isinstance(version, str) or not version:
        pyproject = Path(__file__).resolve().parent.parent / "pyproject.toml"
        try:
            match = re.search(
                r'^version\s*=\s*["\']([^"\']+)["\']',
                pyproject.read_text(),
                re.MULTILINE,
            )
        except OSError:
            match = None
        version = match.group(1) if match else "unknown"

    if prefix is None:
        prefix_line = "source checkout (not installed)"
        target_line = "source tree (no current symlink)"
    else:
        prefix_line = str(prefix)
        current = prefix / "current"
        try:
            target_line = os.readlink(current) if current.is_symlink() else "missing"
        except OSError as error:
            target_line = f"unreadable ({error})"
    return (
        f"version: {version}\n"
        f"install prefix: {prefix_line}\n"
        f"current target: {target_line}"
    )


def execute(name: str, args: list[str], exec_runner=os.execv) -> int:
    target = sibling(name)
    result = exec_runner(str(target), [str(target), *args])
    return 127 if result is None else int(result)


def read_choice(stdin, stderr, prompt: str, *, parse=None):
    """Read a prompt with bounded retries for invalid interactive input."""

    last_error = None
    for attempt in range(PROMPT_ATTEMPTS):
        print(prompt, end="", file=stderr, flush=True)
        value = stdin.readline()
        if value == "":
            if last_error is not None:
                raise last_error
            raise OnboardingError("pneu: input closed during onboarding")
        value = value.strip()
        if parse is None:
            return value
        try:
            return parse(value)
        except OnboardingError as error:
            last_error = error
            if attempt + 1 == PROMPT_ATTEMPTS:
                raise
            print(f"{error}; please try again.", file=stderr)
    raise last_error


def read_yes_no(stdin, stderr, prompt: str) -> bool:
    def parse(value):
        value = value.lower()
        if value in {"", "n", "no"}:
            return False
        if value in {"y", "yes"}:
            return True
        raise OnboardingError(
            f"pneu: expected yes or no, got {value!r}"
        )

    return read_choice(stdin, stderr, prompt, parse=parse)


def _setup_json(
    command: str,
    harness: str,
    *,
    home: Path,
    prefix: Path,
    environ,
    setup_runner=subprocess.run,
) -> dict:
    invocation = [
        str(sibling("roundtable-setup")),
        command,
        "--harness",
        harness,
        "--home",
        str(home),
        "--prefix",
        str(prefix),
        "--json",
    ]
    process_environment = dict(os.environ)
    process_environment.update(environ)
    try:
        result = setup_runner(
            invocation,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            env=process_environment,
        )
    except OSError as error:
        raise OnboardingError(
            f"pneu: cannot run one-time {harness} setup: {error}"
        ) from error
    try:
        payload = json.loads(result.stdout)
    except (TypeError, json.JSONDecodeError) as error:
        detail = (result.stderr or result.stdout or "invalid setup output").strip()
        raise OnboardingError(
            f"pneu: cannot inspect one-time {harness} setup: {detail}"
        ) from error
    if result.returncode != 0 or payload.get("ok") is not True:
        detail = payload.get("error") or result.stderr.strip() or f"exit {result.returncode}"
        raise OnboardingError(
            f"pneu: {harness} integration is not ready: {detail}"
        )
    return payload


def ensure_harness_setup(
    harness: str,
    *,
    home: Path,
    stdin,
    stderr,
    environ,
    setup_runner=subprocess.run,
) -> None:
    """Run the installed package's ownership-safe setup once per harness."""

    if harness == "grok":
        # Grok's native TUI uses a model-armed monitor and installs no hooks,
        # plugins, or LaunchAgents.
        return

    configured_prefix = environ.get("ROUNDTABLE_INSTALL_PREFIX")
    if not configured_prefix:
        # Source-tree/developer invocations intentionally keep setup explicit.
        return
    prefix = Path(configured_prefix).expanduser().resolve()
    status = _setup_json(
        "status",
        harness,
        home=home,
        prefix=prefix,
        environ=environ,
        setup_runner=setup_runner,
    )
    detail = status.get("harnesses", {}).get(harness, {})
    if detail.get("state") == "configured":
        return

    plan = _setup_json(
        "plan",
        harness,
        home=home,
        prefix=prefix,
        environ=environ,
        setup_runner=setup_runner,
    )
    planned = plan.get("harnesses", {}).get(harness, {})
    print(f"One-time {harness} integration setup:", file=stderr)
    for action in planned.get("actions", []):
        print(f"  - {action}", file=stderr)
    if not read_yes_no(stdin, stderr, "Apply these managed changes? [y/N]: "):
        raise OnboardingError(
            f"pneu: {harness} setup was not applied; nothing was launched"
        )
    _setup_json(
        "apply",
        harness,
        home=home,
        prefix=prefix,
        environ=environ,
        setup_runner=setup_runner,
    )
    if harness == "codex":
        print(
            "Codex may ask once to review the pneu SessionStart hook. "
            "Approve it with /hooks; pneu never bypasses hook trust.",
            file=stderr,
        )


def canonical_existing_folder(raw: str, cwd: Path) -> Path:
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute():
        candidate = cwd / candidate
    if candidate.is_symlink():
        raise OnboardingError(
            f"pneu: refusing symbolic-link project folder: {candidate}"
        )
    try:
        # ``Path.resolve()`` changed its non-strict symlink-loop behavior in
        # Python 3.13.  A project anchor must already exist, so resolve it
        # strictly and reject loops/missing components consistently on every
        # supported interpreter.
        resolved = candidate.resolve(strict=True)
    except (OSError, RuntimeError, ValueError) as error:
        raise OnboardingError(
            f"pneu: cannot resolve project folder {candidate}: {error}"
        ) from error
    if not resolved.is_dir():
        raise OnboardingError(
            f"pneu: project folder does not exist: {resolved}"
        )
    return resolved


def forbidden_project_root(root: Path, home: Path) -> bool:
    resolved = root.expanduser().resolve()
    filesystem_root = Path(resolved.anchor)
    return resolved in {home.expanduser().resolve(), filesystem_root}


def run_init_here(
    root: Path,
    *,
    initialize_git: bool,
    init_runner=subprocess.run,
) -> Path:
    command = [str(sibling("roundtable-init")), "--here"]
    if initialize_git:
        command.append("--git")
    result = run_onboarding_init(
        init_runner, command, cwd=root, check=False
    )
    if result.returncode != 0:
        if is_project_root(root):
            raise OnboardingError(
                f"pneu: project already created at {root}; run "
                "pneu again and choose it from the list"
            )
        raise OnboardingError(
            f"pneu: project setup failed with exit {result.returncode}"
        )
    if not is_project_root(root):
        raise OnboardingError(
            f"pneu: setup completed without creating a project at {root}"
        )
    return root


def create_project(
    cwd: Path,
    *,
    stdin,
    stderr,
    home: Path,
    init_runner=subprocess.run,
) -> Path:
    def parse_parent(raw_parent):
        return canonical_existing_folder(raw_parent or str(cwd), cwd)

    parent = read_choice(
        stdin, stderr, f"Parent folder [{cwd}]: ", parse=parse_parent
    )

    def parse_name(name):
        if not name:
            raise OnboardingError("pneu: new folder name cannot be empty")
        return name

    name = read_choice(stdin, stderr, "New folder name: ", parse=parse_name)
    initialize_git = read_yes_no(
        stdin, stderr, "Initialize Git too? [y/N]: "
    )
    target = (parent / name).resolve()
    if forbidden_project_root(target, home):
        raise OnboardingError(
            "pneu: refusing to use the home or filesystem root as a project"
        )
    command = [
        str(sibling("roundtable-init")),
        name,
        "--parent",
        str(parent),
    ]
    if initialize_git:
        command.append("--git")
    result = run_onboarding_init(
        init_runner, command, cwd=cwd, check=False
    )
    if result.returncode != 0:
        if is_project_root(target):
            raise OnboardingError(
                f"pneu: project already created at {target}; run "
                "pneu again and choose it from the list"
            )
        raise OnboardingError(
            f"pneu: project creation failed with exit {result.returncode}"
        )
    if not is_project_root(target):
        raise OnboardingError(
            f"pneu: creation completed without a project at {target}"
        )
    return target


def choose_registered_project(
    roots: list[Path],
    *,
    stdin,
    stderr,
) -> Path:
    print("Choose an existing pneu project:", file=stderr)
    for index, root in enumerate(roots, 1):
        print(f"  {index}) {root}", file=stderr)
    def parse_selection(raw):
        try:
            selected = int(raw)
        except ValueError as error:
            raise OnboardingError(
                f"pneu: invalid existing project selection: {raw!r}"
            ) from error
        if not 1 <= selected <= len(roots):
            raise OnboardingError(
                f"pneu: invalid existing project selection: {raw!r}"
            )
        return roots[selected - 1]

    return read_choice(
        stdin, stderr, "Select existing project: ", parse=parse_selection
    )


def preflight_project_selection(root: Path) -> Path:
    """Validate durable identity and layout before onboarding a seat."""

    try:
        mailbox = resolve_project_mailbox_checked(root)
    except ProjectRegistryError as error:
        raise OnboardingError(
            f"pneu: project registration preflight failed for "
            f"{root}: {error}"
        ) from error
    return mailbox.project_root


def choose_project(
    *,
    cwd: Path,
    home: Path,
    stdin,
    stderr,
    init_runner=subprocess.run,
) -> Path:
    anchored = project_at_or_above(cwd)
    if anchored is not None and not forbidden_project_root(anchored, home):
        print(f"pneu project: {anchored}", file=stderr)
        return preflight_project_selection(anchored)

    if anchored is None:
        print(
            f"This folder is not a pneu project yet: {cwd}",
            file=stderr,
        )

    entries, warnings = load_project_registry()
    emit_registry_warnings(warnings, stream=stderr, tool="pneu")
    registered_roots = [
        entry["root"]
        for entry in active_project_entries(entries, available_only=True)
        if not forbidden_project_root(entry["root"], home)
    ]
    if not registered_roots:
        print(
            "\n"
            "  [project folder]\n"
            "         |\n"
            "  [durable mailboxes]\n"
            "     /    |    \\\n"
            " Claude  Codex  Hermes\n"
            "\n"
            "A pneu project can be any folder; Git is optional.\n",
            file=stderr,
        )
    options = []
    if registered_roots:
        options.append(("registered", None))
    if not forbidden_project_root(cwd, home):
        options.append(("here", cwd))
    options.extend((("another", None), ("create", None)))

    print("Choose a pneu project:", file=stderr)
    for index, (kind, value) in enumerate(options, 1):
        if kind == "registered":
            label = "Choose an existing project"
        elif kind == "here":
            label = f"Set up this folder safely: {cwd}"
        elif kind == "another":
            label = "Set up another existing folder"
        else:
            label = "Create a new folder"
        print(f"  {index}) {label}", file=stderr)

    def parse_selection(raw):
        try:
            selected = int(raw)
        except ValueError as error:
            raise OnboardingError(
                f"pneu: invalid project selection: {raw!r}"
            ) from error
        if not 1 <= selected <= len(options):
            raise OnboardingError(
                f"pneu: invalid project selection: {raw!r}"
            )
        return options[selected - 1]

    kind, value = read_choice(
        stdin, stderr, "Select project: ", parse=parse_selection
    )

    if kind == "registered":
        return preflight_project_selection(
            choose_registered_project(
                registered_roots,
                stdin=stdin,
                stderr=stderr,
            )
        )
    if kind == "create":
        root = create_project(
            cwd,
            stdin=stdin,
            stderr=stderr,
            home=home,
            init_runner=init_runner,
        )
        try:
            return preflight_project_selection(root)
        except OnboardingError as error:
            raise OnboardingError(
                f"{error}; project already created at {root}; run pneu "
                "again and choose it from the list"
            ) from error
    if kind == "another":
        root = read_choice(
            stdin,
            stderr,
            "Existing folder path: ",
            parse=lambda raw: canonical_existing_folder(raw, cwd),
        )
    else:
        root = cwd
    if forbidden_project_root(root, home):
        raise OnboardingError(
            "pneu: refusing to use the home or filesystem root as a project"
        )
    initialize_git = read_yes_no(
        stdin, stderr, "Initialize Git too? [y/N]: "
    )
    root = run_init_here(
        root,
        initialize_git=initialize_git,
        init_runner=init_runner,
    )
    try:
        return preflight_project_selection(root)
    except OnboardingError as error:
        raise OnboardingError(
            f"{error}; project already created at {root}; run pneu "
            "again and choose it from the list"
        ) from error


def seat_inventory(
    root: Path,
) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
    seats = []
    unavailable: list[tuple[str, str]] = []
    for harness in HARNESS_ORDER:
        try:
            ids = configured_sender_ids(root, harness)
        except SelectionError as error:
            raise OnboardingError(f"pneu: {error}") from error
        try:
            harness_bin(harness)
        except SelectionError as error:
            detail = harness_unavailable_detail(harness, error)
            if ids:
                unavailable.append((harness, detail))
            else:
                unavailable.append((harness, f"not configured in this project; {detail}"))
            continue
        if not ids:
            unavailable.append(
                (
                    harness,
                    f"not configured in this project; add a {harness} seat to "
                    ".roundtable/agents.yaml",
                )
            )
            continue
        seats.extend((harness, agent_id) for agent_id in ids)
    return seats, unavailable


def _addable_harnesses(root: Path) -> list[str]:
    """Return installed harnesses that have no configured project seat."""

    addable = []
    for harness in HARNESS_ORDER:
        try:
            if configured_sender_ids(root, harness):
                continue
            harness_bin(harness)
        except SelectionError:
            continue
        addable.append(harness)
    return addable


def _codex_wake_state_path() -> Path:
    return runtime_root() / "rt-codex-wake-state.json"


def _bound_codex_thread(root: Path, agent: str) -> str | None:
    """Read one resumable binding; corrupt or unsafe state is a quiet miss."""

    try:
        path = _codex_wake_state_path()
        descriptor = os.open(
            path,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
        )
        with os.fdopen(descriptor, "rb") as handle:
            info = os.fstat(handle.fileno())
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_uid != os.getuid()
                or info.st_size > 4 * 1024 * 1024
            ):
                return None
            raw = handle.read(4 * 1024 * 1024 + 1)
        if len(raw) > 4 * 1024 * 1024:
            return None
        value = json.loads(raw.decode("utf-8"))
        if not isinstance(value, dict) or value.get("schema") != CODEX_WAKE_STATE_SCHEMA:
            return None
        bindings = value.get("bindings")
        if not isinstance(bindings, dict):
            return None
        binding = bindings.get(str(root))
        if not isinstance(binding, dict):
            return None
        if binding.get("project") != str(root) or binding.get("agent") != agent:
            return None
        thread_id = binding.get("threadId")
        if not isinstance(thread_id, str) or not thread_id:
            return None
        inspection = inspect_seat(root, agent)
        if inspection.status not in {"vacant", "stale"}:
            return None
        return thread_id
    except (
        OSError,
        UnicodeError,
        json.JSONDecodeError,
        RuntimeStateError,
        ValueError,
    ):
        return None


def _bound_codex_threads(
    root: Path,
    seats: list[tuple[str, str]],
) -> dict[tuple[str, str], str]:
    bindings = {}
    for harness, agent in seats:
        if harness != "codex":
            continue
        thread_id = _bound_codex_thread(root, agent)
        if thread_id:
            bindings[(harness, agent)] = thread_id
    return bindings


def _append_harness_seat(root: Path, harness: str) -> str:
    """Atomically append one roundtable-init-shaped seat block."""

    if harness not in HARNESS_CONFIG:
        raise OnboardingError(f"pneu: unsupported harness seat: {harness}")
    path = root / ".roundtable" / "agents.yaml"
    descriptor = None
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
        )
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise OnboardingError(
                "pneu: refusing add-seat because agents.yaml is not a "
                f"user-owned regular file: {path}"
            )
        with os.fdopen(descriptor, "rb") as handle:
            descriptor = None
            raw = handle.read()
    except OnboardingError:
        if descriptor is not None:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor is not None:
            os.close(descriptor)
        raise OnboardingError(
            f"pneu: cannot read agents configuration {path}: {error}"
        ) from error

    try:
        text = raw.decode("utf-8")
    except UnicodeError as error:
        raise OnboardingError(
            f"pneu: refusing add-seat because agents.yaml is not UTF-8: {path}"
        ) from error
    try:
        document = load_agents_doc(root, "pneu")
    except (SystemExit, OSError, UnicodeError) as error:
        raise OnboardingError(
            f"pneu: refusing add-seat because agents.yaml cannot be parsed: {error}"
        ) from error
    if document.get("schema") != "roundtable.agents.v1":
        raise OnboardingError(
            "pneu: refusing add-seat because agents.yaml schema drift cannot be "
            "safely appended"
        )
    agents = document.get("agents")
    if not isinstance(agents, dict):
        raise OnboardingError(
            "pneu: refusing add-seat because agents.yaml has no agents mapping"
        )

    config_name, harness_name = HARNESS_CONFIG[harness]
    aliases = CONFIG_HARNESSES[harness]
    for existing_name, existing in agents.items():
        if not isinstance(existing, dict):
            raise OnboardingError(
                "pneu: refusing add-seat because agents.yaml contains an "
                f"unsupported seat block: {existing_name!r}"
            )
        if existing_name == config_name or existing.get("harness") in aliases:
            raise OnboardingError(
                f"pneu: {HARNESS_LABELS[harness]} already has a project seat block"
            )

    lines = text.splitlines()
    agents_lines = [
        index
        for index, line in enumerate(lines)
        if re.fullmatch(r"agents:\s*(?:#.*)?", line)
    ]
    if len(agents_lines) != 1 or any(
        line.strip()
        and not line.lstrip().startswith("#")
        and not line.startswith((" ", "\t"))
        for line in lines[agents_lines[0] + 1 :] if agents_lines
    ):
        raise OnboardingError(
            "pneu: refusing add-seat because agents.yaml layout drift cannot be "
            "safely appended"
        )

    if raw.endswith(b"\n\n"):
        separator = b""
    elif raw.endswith(b"\n"):
        separator = b"\n"
    else:
        separator = b"\n\n"
    block = (
        f"  {config_name}:\n"
        f"    harness: {harness_name}\n"
        "    instances:\n"
        f"      - id: {config_name}\n"
    ).encode("utf-8")
    payload = raw + separator + block
    identity = (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns)
    temporary = path.with_name(f".{path.name}.tmp.{os.getpid()}.{time.time_ns()}")
    temp_descriptor = None
    try:
        temp_descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            stat.S_IMODE(info.st_mode),
        )
        os.fchmod(temp_descriptor, stat.S_IMODE(info.st_mode))
        with os.fdopen(temp_descriptor, "wb") as handle:
            temp_descriptor = None
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        current = path.lstat()
        current_identity = (
            current.st_dev,
            current.st_ino,
            current.st_size,
            current.st_mtime_ns,
        )
        if current_identity != identity:
            raise OnboardingError(
                f"pneu: refusing add-seat because agents.yaml changed while editing: {path}"
            )
        os.replace(temporary, path)
        directory = os.open(
            path.parent,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0),
        )
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except OnboardingError:
        raise
    except OSError as error:
        raise OnboardingError(
            f"pneu: cannot update agents configuration {path}: {error}"
        ) from error
    finally:
        if temp_descriptor is not None:
            os.close(temp_descriptor)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        except OSError:
            pass
    return f"added {HARNESS_LABELS[harness]} seat {config_name}"


def choose_seat(root: Path, *, stdin, stderr) -> tuple[str, str]:
    seats, unavailable = seat_inventory(root)
    print("Choose a harness seat:", file=stderr)
    for index, (harness, agent_id) in enumerate(seats, 1):
        activation_hint = (
            " (starts with a visible automatic pneu activation turn)"
            if harness in {"codex", "grok"}
            else ""
        )
        print(
            f"  {index}) {harness} — {agent_id}{activation_hint}",
            file=stderr,
        )
    for harness, detail in unavailable:
        print(
            f"  unavailable: {harness} ({HARNESS_LABELS[harness]}) — {detail}",
            file=stderr,
        )
    if not seats:
        detail = " | ".join(f"{name}: {error}" for name, error in unavailable)
        raise OnboardingError(
            f"pneu: no launchable configured harness seats in {root}"
            + (f"; {detail}" if detail else "")
        )
    def parse_selection(raw):
        try:
            selected = int(raw)
        except ValueError as error:
            raise OnboardingError(
                f"pneu: invalid harness selection: {raw!r}"
            ) from error
        if not 1 <= selected <= len(seats):
            raise OnboardingError(
                f"pneu: invalid harness selection: {raw!r}"
            )
        return seats[selected - 1]

    return read_choice(
        stdin, stderr, "Select harness: ", parse=parse_selection
    )


def _launcher_state_path(root: Path) -> Path:
    return root / ".roundtable" / "launcher.json"


def _read_launcher_state(root: Path) -> dict:
    path = _launcher_state_path(root)
    try:
        info = path.lstat()
    except FileNotFoundError:
        return {
            "schema": LAUNCHER_STATE_SCHEMA,
            "welcomePending": False,
            "lastSeat": None,
        }
    except OSError as error:
        raise OnboardingError(f"pneu: cannot inspect launcher state {path}: {error}") from error
    if path.is_symlink() or not path.is_file():
        raise OnboardingError(f"pneu: launcher state is not a regular file: {path}")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise OnboardingError(f"pneu: cannot read launcher state {path}: {error}") from error
    if not isinstance(value, dict) or value.get("schema") != LAUNCHER_STATE_SCHEMA:
        raise OnboardingError(f"pneu: launcher state has an invalid schema: {path}")
    pending = value.get("welcomePending")
    last = value.get("lastSeat")
    if not isinstance(pending, bool) or (last is not None and not isinstance(last, str)):
        raise OnboardingError(f"pneu: launcher state is malformed: {path}")
    return value


def _write_launcher_state(root: Path, value: dict) -> None:
    path = _launcher_state_path(root)
    if path.is_symlink():
        raise OnboardingError(f"pneu: refusing symlinked launcher state: {path}")
    temporary = path.with_name(f".{path.name}.tmp.{os.getpid()}.{time.time_ns()}")
    payload = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")
    descriptor = None
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = None
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        os.chmod(path, 0o600)
    except OSError as error:
        if descriptor is not None:
            os.close(descriptor)
        try:
            temporary.unlink()
        except OSError:
            pass
        raise OnboardingError(f"pneu: cannot update launcher state {path}: {error}") from error


def _rich_card_available(stdin, stderr) -> bool:
    try:
        return bool(stdin.isatty() and stderr.isatty())
    except (AttributeError, OSError):
        return False


def _read_card_key(stdin) -> str:
    # Read raw bytes from the descriptor: buffered text reads slurp a whole
    # escape sequence into the Python-side buffer, leaving the descriptor
    # empty so a readiness probe for the suffix always times out.
    descriptor = stdin.fileno()
    previous = termios.tcgetattr(descriptor)
    try:
        tty.setcbreak(descriptor, when=termios.TCSANOW)
        first = os.read(descriptor, 1)
        character = first.decode("utf-8", "replace")
        if character in {"\r", "\n"}:
            return "enter"
        if character == "\x1b":
            suffix = ""
            for _index in range(2):
                ready, _write, _error = select.select([descriptor], [], [], 0.05)
                if not ready:
                    break
                chunk = os.read(descriptor, 1)
                if not chunk:
                    break
                suffix += chunk.decode("utf-8", "replace")
            return {"[A": "up", "[B": "down"}.get(suffix, "unknown")
        return character.lower()
    finally:
        termios.tcsetattr(descriptor, termios.TCSANOW, previous)


def _active_worktree_count(root: Path) -> int:
    try:
        entries, _warnings = load_project_registry()
    except ProjectRegistryError:
        return 0
    current = next(
        (
            entry
            for entry in active_project_entries(entries, available_only=True)
            if Path(entry["root"]).expanduser().resolve() == root
        ),
        None,
    )
    if not isinstance(current, dict):
        return 0
    group = current.get("group")
    return sum(
        1
        for entry in active_project_entries(entries, available_only=True)
        if entry.get("group") == group
        and Path(entry["root"]).expanduser().resolve() != root
    )


def _unread_by_seat(root: Path, seats: list[tuple[str, str]]) -> list[tuple[str, int]]:
    try:
        mailbox = resolve_project_mailbox_checked(root)
    except ProjectRegistryError:
        return [(agent, 0) for _harness, agent in seats]
    counts = []
    for _harness, agent in seats:
        directory = mailbox.inbox_dir / agent / "new"
        try:
            count = sum(
                1
                for path in directory.iterdir()
                if not path.name.startswith((".", "ack-"))
            )
        except FileNotFoundError:
            count = 0
        counts.append((agent, count))
    return counts


def _phone_access_on(root: Path) -> bool:
    try:
        return load_state_for_project(root) is not None
    except RCHostError:
        return False


def _render_seat_card(
    root: Path,
    seats: list[tuple[str, str]],
    unavailable: list[tuple[str, str]],
    addable: list[str],
    bound_threads: dict[tuple[str, str], str],
    cursor: int,
    *,
    stderr,
    notice: str = "",
) -> None:
    print("\x1b[2J\x1b[H", end="", file=stderr)
    print(f"pneu — {root.name}", file=stderr)
    print("seats", file=stderr)
    for index, (harness, agent) in enumerate(seats):
        marker = ">" if index == cursor else " "
        bound = " (bound thread)" if (harness, agent) in bound_threads else ""
        print(
            f" {marker} {HARNESS_LABELS[harness]} — {agent}{bound}",
            file=stderr,
        )
    for harness, detail in unavailable:
        if harness in addable:
            detail = "not configured in this project — press a to add"
        print(f"   unavailable: {HARNESS_LABELS[harness]} — {detail}", file=stderr)
    unread = " ".join(
        f"{agent}={count}" for agent, count in _unread_by_seat(root, seats)
    ) or "none"
    print(f"active worktrees: {_active_worktree_count(root)}", file=stderr)
    print(f"unread mail: {unread}", file=stderr)
    print(
        f"Claude phone connection: {'on' if _phone_access_on(root) else 'off'}  [p]",
        file=stderr,
    )
    footer = "↑↓/1-9 select · Enter launch"
    if addable:
        footer += " · a add seat"
    footer += " · p Claude phone · w worktrees · ? guide · q quit"
    print(footer, file=stderr)
    if notice:
        print(notice, file=stderr)
    stderr.flush()


def _choose_addable_harness(addable: list[str], *, stdin, stderr) -> str | None:
    choices = " · ".join(
        f"{index} {HARNESS_LABELS[harness]}"
        for index, harness in enumerate(addable, 1)
    )
    print(f"Add seat: {choices} · q cancel", file=stderr, flush=True)
    while True:
        key = _read_card_key(stdin)
        if key == "q":
            return None
        if key.isdigit() and 1 <= int(key) <= len(addable):
            return addable[int(key) - 1]


def _run_card_command(name: str, arguments: list[str], root: Path) -> tuple[int, str]:
    target = sibling(name)
    try:
        result = subprocess.run(
            [str(target), *arguments],
            cwd=root,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as error:
        return 2, str(error)
    detail = (result.stderr or result.stdout).strip()
    return result.returncode, detail


def _show_reference(text: str, *, stdin, stderr) -> None:
    print("\x1b[2J\x1b[H", end="", file=stderr)
    print(text, end="" if text.endswith("\n") else "\n", file=stderr)
    print("Press Enter to return.", file=stderr, flush=True)
    while _read_card_key(stdin) != "enter":
        pass


def _toggle_phone_access(root: Path) -> str:
    action = "disable" if _phone_access_on(root) else "enable"
    code, detail = _run_card_command("rt-rc-host", [action], root)
    if code == 0:
        return f"Claude phone connection {action}d"
    return (
        detail.splitlines()[-1]
        if detail
        else f"Claude phone connection {action} failed"
    )


def show_first_run_welcome(root: Path, *, stdin, stderr) -> bool:
    state = _read_launcher_state(root)
    if not state.get("welcomePending"):
        return True
    notice = ""
    while True:
        print("\x1b[2J\x1b[H", end="", file=stderr)
        print(f"Welcome to pneu — {root.name}", file=stderr)
        print("Local agent seats share durable project mailboxes.", file=stderr)
        print("Tutorial now? no  [?]", file=stderr)
        print("Claude phone connection now? no  [p]", file=stderr)
        print(
            "The Claude phone connection affects only Claude mobile/web "
            "remote sessions for this project; desktop seats and other "
            "harnesses are untouched.",
            file=stderr,
        )
        print("Enter continue · ? guide · p Claude phone · q quit", file=stderr)
        if notice:
            print(notice, file=stderr)
        stderr.flush()
        key = _read_card_key(stdin)
        if key == "?":
            _show_reference(ASCII_GUIDE, stdin=stdin, stderr=stderr)
            continue
        if key == "p":
            notice = _toggle_phone_access(root)
            if not _phone_access_on(root):
                continue
        if key == "q":
            state["welcomePending"] = False
            _write_launcher_state(root, state)
            return False
        if key not in {"enter", "p"}:
            continue
        state["welcomePending"] = False
        _write_launcher_state(root, state)
        return True


def choose_seat_card(
    root: Path,
    *,
    stdin,
    stderr,
    selection_meta: dict | None = None,
    notice: str = "",
) -> tuple[str, str] | None:
    seats, unavailable = seat_inventory(root)
    addable = _addable_harnesses(root)
    if not seats and not addable:
        detail = " | ".join(f"{name}: {error}" for name, error in unavailable)
        raise OnboardingError(
            f"pneu: no launchable configured harness seats in {root}"
            + (f"; {detail}" if detail else "")
        )
    state = _read_launcher_state(root)
    last = state.get("lastSeat")
    keys = [f"{harness}:{agent}" for harness, agent in seats]
    cursor = keys.index(last) if last in keys else 0
    if selection_meta is not None:
        selection_meta.clear()
    while True:
        bound_threads = _bound_codex_threads(root, seats)
        _render_seat_card(
            root,
            seats,
            unavailable,
            addable,
            bound_threads,
            cursor,
            stderr=stderr,
            notice=notice,
        )
        notice = ""
        key = _read_card_key(stdin)
        if key == "up" and seats:
            cursor = (cursor - 1) % len(seats)
        elif key == "down" and seats:
            cursor = (cursor + 1) % len(seats)
        elif key.isdigit() and 1 <= int(key) <= len(seats):
            cursor = int(key) - 1
        elif key == "a" and addable:
            harness = _choose_addable_harness(
                addable,
                stdin=stdin,
                stderr=stderr,
            )
            if harness is None:
                continue
            try:
                notice = _append_harness_seat(root, harness)
            except OnboardingError as error:
                notice = str(error)
                continue
            seats, unavailable = seat_inventory(root)
            addable = _addable_harnesses(root)
            selected_key = f"{harness}:{HARNESS_CONFIG[harness][0]}"
            keys = [f"{name}:{agent}" for name, agent in seats]
            cursor = keys.index(selected_key) if selected_key in keys else 0
        elif key == "p":
            notice = _toggle_phone_access(root)
        elif key == "w":
            code, detail = _run_card_command("rt-worktree", ["list"], root)
            _show_reference(
                detail or f"pneu worktree list exited {code}",
                stdin=stdin,
                stderr=stderr,
            )
        elif key == "?":
            _show_reference(ASCII_GUIDE, stdin=stdin, stderr=stderr)
        elif key == "q":
            return None
        elif key == "enter":
            if not seats:
                notice = "No configured seat yet; press a to add one"
                continue
            selected = seats[cursor]
            thread_id = bound_threads.get(selected)
            if thread_id and selection_meta is not None:
                selection_meta["resumeThreadId"] = thread_id
            return selected


def remember_last_seat(root: Path, harness: str, agent: str) -> None:
    state = _read_launcher_state(root)
    state["lastSeat"] = f"{harness}:{agent}"
    _write_launcher_state(root, state)


def project_ready_recovery(error, root: Path) -> OnboardingError:
    return OnboardingError(
        f"{error}; project already created at {root}; run pneu again "
        "and choose it from the list"
    )


def onboard(
    *,
    cwd: Path,
    home: Path,
    stdin,
    stderr,
    environ,
    init_runner=subprocess.run,
    setup_runner=subprocess.run,
    exec_runner=os.execv,
    chdir_runner=os.chdir,
) -> int:
    root = None
    try:
        root = choose_project(
            cwd=cwd,
            home=home,
            stdin=stdin,
            stderr=stderr,
            init_runner=init_runner,
        )
        rich_card = _rich_card_available(stdin, stderr)
        if rich_card:
            if not show_first_run_welcome(root, stdin=stdin, stderr=stderr):
                return 0
        card_notice = ""
        while True:
            selection_meta = {}
            if rich_card:
                selected = choose_seat_card(
                    root,
                    stdin=stdin,
                    stderr=stderr,
                    selection_meta=selection_meta,
                    notice=card_notice,
                )
                if selected is None:
                    return 0
                harness, agent_id = selected
            else:
                harness, agent_id = choose_seat(root, stdin=stdin, stderr=stderr)
            ensure_harness_setup(
                harness,
                home=home,
                stdin=stdin,
                stderr=stderr,
                environ=environ,
                setup_runner=setup_runner,
            )
            thread_id = selection_meta.get("resumeThreadId")
            launch_arguments = []
            if rich_card and harness == "codex" and isinstance(thread_id, str):
                code, detail = _run_card_command(
                    "rt-codex-wake",
                    ["handoff", str(root), "--thread-id", thread_id],
                    root,
                )
                if code != 0:
                    card_notice = (
                        detail.splitlines()[-1]
                        if detail
                        else "Codex thread handoff refused"
                    )
                    continue
                launch_arguments = ["resume", thread_id]
            remember_last_seat(root, harness, agent_id)
            environ["RT_FROM"] = agent_id
            chdir_runner(root)
            return execute(
                f"rt-{harness}",
                launch_arguments,
                exec_runner=exec_runner,
            )
    except OnboardingError as error:
        if root is not None and is_project_root(root):
            raise project_ready_recovery(error, root) from error
        raise
    except KeyboardInterrupt:
        print(
            "pneu: cancelled by user (Ctrl-C); no agent session was launched.",
            file=stderr,
        )
        if root is not None and is_project_root(root):
            print(
                f"project already created at {root}; run pneu again and "
                "choose it from the list",
                file=stderr,
            )
        return 130


def main(
    argv: list[str] | None = None,
    *,
    cwd: Path | None = None,
    home: Path | None = None,
    stdin=None,
    stdout=None,
    stderr=None,
    environ=None,
    init_runner=subprocess.run,
    setup_runner=subprocess.run,
    exec_runner=os.execv,
    chdir_runner=os.chdir,
) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    cwd = (cwd or Path.cwd()).expanduser().resolve()
    home = (home or Path.home()).expanduser().resolve()
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    stderr = sys.stderr if stderr is None else stderr
    environ = os.environ if environ is None else environ

    try:
        if argv:
            command = argv[0]
            if command in {"help", "-h", "--help"}:
                print(HELP, end="", file=stdout)
                return 0
            if command == "guide":
                print(ASCII_GUIDE, end="", file=stdout)
                return 0
            if command == "version":
                print(version_report(), file=stdout)
                return 0
            target = ALIASES.get(command)
            if target is None:
                print(f"pneu: unknown command: {command}", file=stderr)
                print(HELP, end="", file=stderr)
                return 2
            if command in HARNESS_ORDER:
                try:
                    harness_bin(command)
                except SelectionError as error:
                    raise OnboardingError(f"pneu: {error}") from error
                ensure_harness_setup(
                    command,
                    home=home,
                    stdin=stdin,
                    stderr=stderr,
                    environ=environ,
                    setup_runner=setup_runner,
                )
            return execute(target, argv[1:], exec_runner=exec_runner)

        if not stdin.isatty():
            print(
                "pneu: no command given and stdin is not a TTY",
                file=stderr,
            )
            print(HELP, end="", file=stderr)
            return 2
        return onboard(
            cwd=cwd,
            home=home,
            stdin=stdin,
            stderr=stderr,
            environ=environ,
            init_runner=init_runner,
            setup_runner=setup_runner,
            exec_runner=exec_runner,
            chdir_runner=chdir_runner,
        )
    except OnboardingError as error:
        print(error, file=stderr)
        return 2
    except KeyboardInterrupt:
        print(
            "pneu: cancelled by user (Ctrl-C); no agent session was launched.",
            file=stderr,
        )
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
