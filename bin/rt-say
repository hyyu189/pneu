#!/usr/bin/env python3
import json
import os
import re
import select
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

from _rtlib import (
    MailEnvelopeError,
    ProjectAddress,
    ProjectRegistryError,
    authenticate_fenced_sender,
    find_project_root,
    format_mail_envelope,
    load_agents_doc,
    locked_project_mailbox,
    parse_mail_envelope,
    parse_message_id,
    resolve_project_address,
)

TOOL_DIR = Path(__file__).resolve().parent


ROOT = find_project_root("rt-say")
STATE_DIR = ROOT / ".roundtable"
RUNTIME = STATE_DIR / "runtime.json"
LOCK_DIR = None
MSG_DIR = None
INBOX_DIR = None
LEDGER_LOCK = None
LIFECYCLE_ORDINAL = {"pending": 0, "injected": 1, "submitted": 2, "accepted": 3, "acked": 4}
AGENT_COMPONENT_RE = re.compile(r"^[a-z0-9#_-]+$")
MAIL_KIND_RE = re.compile(r"^[^\s\]\x00]+$")
UNSUPPORTED_MESSAGE_OPTIONS = ("--kind", "--refs")
LEGACY_FAILURE_EXIT = 3
LEGACY_OPERATION_ACTIVE = False


def usage():
    print(
        "usage: rt-say [--verbose] [--fenced] "
        "[--no-nudge | --legacy-nudge-only] "
        "<agent-or-instance>[@<project-name>] <kind> <body...>",
        file=sys.stderr,
    )
    raise SystemExit(2)


def print_help():
    print(
        """usage: rt-say [--verbose] [--fenced] [--no-nudge | --legacy-nudge-only] <agent-or-instance>[@<project-name>] <kind> <body...>

Deliver a roundtable message through the project's maildir. A successful atomic
write to inbox/<agent>/new is successful delivery and exits 0. Normal delivery
does not require a topology map and never touches the keyboard. The @project
form addresses exactly one registered sibling worktree in the same derived
group.

options:
  --fenced             require the current Roundtable launcher lease; use with --no-nudge
  --no-nudge           compatibility alias; normal delivery is already maildir-only
  --legacy-nudge-only  emergency legacy cmux path; do not write maildir; failures exit 3
  --verbose            print route and submit details
  -h, --help           show this help

The legacy path is human-coordinated and fails independently with exit 3.
"""
    )


def utc_now():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def run(*args, **kwargs):
    return subprocess.run(args, text=True, check=True, **kwargs)


def run_json(*args):
    return json.loads(subprocess.check_output(args, text=True))


def acquire_lock(path, timeout=None):
    deadline = None if timeout is None else time.time() + timeout
    while True:
        try:
            path.mkdir(parents=True)
            return
        except FileExistsError:
            if timeout is None or time.time() >= deadline:
                raise SystemExit(f"rt-say: lock busy: {path}")
            time.sleep(0.05)


def release_lock(path):
    shutil.rmtree(path, ignore_errors=True)


def configured_target(root, target, *, required=True, runtime=None):
    """Resolve a configured target to (base agent, concrete instance)."""
    doc = load_agents_doc(root, "rt-say")
    agents = doc.get("agents") or {}
    if not isinstance(agents, dict):
        raise SystemExit(
            "rt-say: invalid agents configuration: agents must be a mapping"
        )
    exact_candidates = []
    base_candidates = []
    valid_names = set()
    for base, config in agents.items():
        if not isinstance(base, str) or not AGENT_COMPONENT_RE.fullmatch(base):
            raise SystemExit(
                "rt-say: invalid agents configuration: invalid base agent "
                f"{base!r}"
            )
        base_name = base
        valid_names.add(base_name)
        if not isinstance(config, dict):
            raise SystemExit(
                "rt-say: invalid agents configuration for "
                f"{base_name}: expected a mapping"
            )
        instances = config.get("instances")
        if instances is None or instances == []:
            instances = [{"id": base_name}]
        elif not isinstance(instances, list):
            raise SystemExit(
                "rt-say: invalid agents configuration for "
                f"{base_name}: instances must be a list"
            )
        instance_names = []
        for instance in instances:
            if isinstance(instance, str):
                instance_name = instance
            elif isinstance(instance, dict):
                instance_id = instance.get("id")
                if not isinstance(instance_id, str) or not instance_id:
                    raise SystemExit(
                        "rt-say: invalid agents configuration for "
                        f"{base_name}: every instance needs an id"
                    )
                instance_name = instance_id
            else:
                raise SystemExit(
                    "rt-say: invalid agents configuration for "
                    f"{base_name}: instance entries must be strings or mappings"
                )
            if not AGENT_COMPONENT_RE.fullmatch(instance_name):
                raise SystemExit(
                    "rt-say: invalid agents configuration for "
                    f"{base_name}: invalid instance id {instance_name!r}"
                )
            instance_names.append(instance_name)
            valid_names.add(instance_name)
            if instance_name == target:
                exact_candidates.append((base_name, instance_name))
        if base_name == target:
            base_candidates.append((base_name, instance_names))
    if len(exact_candidates) == 1:
        return exact_candidates[0]
    if len(exact_candidates) > 1:
        matches = ", ".join(
            f"{base}/{instance}"
            for base, instance in sorted(exact_candidates)
        )
        raise SystemExit(
            f"rt-say: ambiguous configured agent or instance {target}: "
            f"{matches}"
        )
    if len(base_candidates) > 1:
        matches = ", ".join(base for base, _instances in base_candidates)
        raise SystemExit(
            f"rt-say: ambiguous configured base agent {target}: {matches}"
        )
    if len(base_candidates) == 1:
        base_name, instance_names = base_candidates[0]
        if len(instance_names) == 1:
            return base_name, instance_names[0]
        raise SystemExit(
            f"rt-say: {target} has multiple instances; use one of: "
            + ", ".join(sorted(set(instance_names)))
        )
    if not required and target in ((runtime or {}).get("agents") or {}):
        return target, target
    rendered = ", ".join(sorted(valid_names)) or "none configured"
    raise SystemExit(
        f"rt-say: unknown agent or instance: {target}; use one of: {rendered}"
    )


def infer_sender_from_harness_env(root):
    """Infer a unique Codex instance for shared app-server turn shells."""
    thread_id = os.environ.get("CODEX_THREAD_ID")
    if not thread_id:
        return ""
    doc = load_agents_doc(root, "rt-say")
    exact = []
    candidates = []
    for base, raw_config in (doc.get("agents") or {}).items():
        config = raw_config if isinstance(raw_config, dict) else {}
        if str(config.get("harness") or base).lower() != "codex":
            continue
        base_name = str(base).lower()
        instances = config.get("instances") or [{"id": base_name}]
        for instance in instances:
            if isinstance(instance, str):
                instance_id = instance.lower()
                session_id = None
            else:
                instance_id = str((instance or {}).get("id") or base_name).lower()
                session_id = (instance or {}).get("session_id")
            candidates.append(instance_id)
            if session_id == thread_id:
                exact.append(instance_id)
    if len(exact) == 1:
        return exact[0]
    return candidates[0] if len(candidates) == 1 else ""


def validate_agent_component(value, label):
    if not AGENT_COMPONENT_RE.fullmatch(value):
        raise SystemExit(
            f"rt-say: invalid {label} agent component: {value}; "
            "expected pattern [a-z0-9#_-]+"
        )


def warn_if_target_not_active(root, target):
    """Report a dead target after durable delivery without blocking delivery."""

    try:
        from _rtruntime import RuntimeStateError, inspect_seat

        inspection = inspect_seat(root, target)
    except (OSError, RuntimeStateError):
        inspection = None
    if inspection is None or not str(
        getattr(inspection, "status", "")
    ).startswith("active_"):
        print(
            f"note: no active seat observed for {target}; mail is durable and "
            "will deliver when the seat resumes.",
            file=sys.stderr,
        )
        return


def parse_target_address(value):
    """Return ``(agent, optional exact project name)``."""

    if value.count("@") > 1:
        raise SystemExit(
            "rt-say: invalid project address: expected "
            "<agent-or-instance>@<project-name>"
        )
    agent, separator, project_name = value.partition("@")
    agent = agent.lower()
    if separator and (not agent or not project_name):
        raise SystemExit(
            "rt-say: invalid project address: expected "
            "<agent-or-instance>@<project-name>"
        )
    validate_agent_component(agent, "target")
    return agent, project_name if separator else None


def positional_args(args):
    return [
        arg
        for arg in args
        if arg
        not in {
            "--verbose",
            "--fenced",
            "--no-nudge",
            "--legacy-nudge-only",
        }
    ]


def validate_ack_route(address, target, *, mailbox=None):
    """Require durable inbound evidence for every quiet acknowledgement."""

    sender = os.environ.get("RT_FROM", "").lower()
    refs = [
        ref
        for ref in os.environ.get("RT_ACK_REFS", "").split(",")
        if ref
    ]
    if not sender or not refs:
        raise SystemExit(
            "rt-say: acknowledgement UUID target requires inbound refs "
            "and RT_FROM"
        )
    if mailbox is None:
        with locked_project_mailbox(ROOT, tool="rt-say") as locked_mailbox:
            return validate_ack_route(
                address,
                target,
                mailbox=locked_mailbox,
            )
    if mailbox.project_uuid != address.origin_uuid:
        raise SystemExit(
            "rt-say: acknowledgement receiver identity changed: "
            f"expected {address.origin_uuid}, "
            f"resolved {mailbox.project_uuid}"
        )
    for ref in refs:
        identity = parse_message_id(ref, recipient=sender)
        if identity != (target, sender):
            raise SystemExit(
                "rt-say: acknowledgement UUID target does not match "
                f"inbound ref: {ref}"
            )
        inbox = mailbox.inbox_dir / sender
        directories = (inbox, inbox / "new", inbox / "cur")
        for directory in directories:
            try:
                directory_info = directory.lstat()
            except FileNotFoundError:
                continue
            if (
                stat.S_ISLNK(directory_info.st_mode)
                or not stat.S_ISDIR(directory_info.st_mode)
            ):
                raise SystemExit(
                    "rt-say: acknowledgement maildir path is not a real "
                    f"directory: {directory}"
                )
        paths = []
        for directory in directories[1:]:
            path = directory / f"{ref}.md"
            try:
                path.lstat()
            except FileNotFoundError:
                continue
            paths.append(path)
        if not paths:
            raise SystemExit(
                "rt-say: acknowledgement UUID target lacks inbound "
                f"evidence for ref: {ref}"
            )
        identities = []
        for path in paths:
            info = path.lstat()
            if not stat.S_ISREG(info.st_mode):
                raise SystemExit(
                    "rt-say: acknowledgement inbound evidence is not a "
                    f"regular file: {path}"
                )
            identities.append((info.st_dev, info.st_ino))
        if len(set(identities)) != 1:
            raise SystemExit(
                "rt-say: conflicting acknowledgement inbound evidence "
                f"for ref: {ref}"
            )
        try:
            envelope = parse_mail_envelope(
                paths[0].read_text(encoding="utf-8")
            )
        except (MailEnvelopeError, OSError, UnicodeError) as error:
            raise SystemExit(
                "rt-say: invalid acknowledgement inbound evidence for "
                f"{ref}: {error}"
            ) from None
        cross_project = address.origin_uuid != address.target_uuid
        if envelope is None or envelope.get("origin_uuid") is None:
            if not cross_project:
                continue
        elif (
            envelope.get("origin_uuid") == address.target_uuid
            and envelope.get("msg_id") == ref
            and envelope.get("from") == target
            and envelope.get("to") == sender
        ):
            continue
        raise SystemExit(
            "rt-say: acknowledgement UUID target is not authorized "
            f"by inbound ref: {ref}"
        )


def requested_project_address(args):
    """Resolve scoped delivery only after sender fence authentication."""

    positional = positional_args(args)
    if len(positional) < 2:
        usage()
    target, project_name = parse_target_address(positional[0])
    direct_uuid = os.environ.get("RT_TARGET_PROJECT_UUID", "").strip()
    ack_mode = os.environ.get("RT_ACK_MODE") == "1"
    requested_kind = positional[1] if len(positional) > 1 else ""
    if ack_mode and requested_kind != "sync-ack":
        raise SystemExit("rt-say: RT_ACK_MODE is reserved for rt-ack")
    if direct_uuid and (not ack_mode or requested_kind != "sync-ack"):
        raise SystemExit(
            "rt-say: RT_TARGET_PROJECT_UUID is reserved for rt-ack"
        )
    if project_name and direct_uuid:
        raise SystemExit(
            "rt-say: project name and acknowledgement UUID target conflict"
        )
    if ack_mode and project_name:
        raise SystemExit(
            "rt-say: acknowledgement cross-project routing requires "
            "rt-ack's UUID target"
        )
    if (project_name or direct_uuid) and "--legacy-nudge-only" in args:
        raise SystemExit(
            "rt-say: cross-worktree addressing is maildir-only and cannot "
            "use --legacy-nudge-only"
        )
    if not project_name and not direct_uuid:
        if ack_mode:
            with locked_project_mailbox(ROOT, tool="rt-say") as mailbox:
                local_address = ProjectAddress(
                    origin_uuid=mailbox.project_uuid,
                    origin_root=ROOT,
                    origin_group="",
                    target_uuid=mailbox.project_uuid,
                    target_root=ROOT,
                    target_name=ROOT.name,
                )
                validate_ack_route(
                    local_address,
                    target,
                    mailbox=mailbox,
                )
        return target, None
    try:
        address = resolve_project_address(
            ROOT,
            target_name=project_name,
            target_uuid=direct_uuid or None,
        )
    except ProjectRegistryError as error:
        raise SystemExit(f"rt-say: project address failed: {error}") from None
    if direct_uuid:
        validate_ack_route(address, target)
    return target, address


def reject_unsupported_message_options(args):
    for arg in args:
        option = arg.split("=", 1)[0]
        if option in UNSUPPORTED_MESSAGE_OPTIONS:
            print(
                f"rt-say: {option} is not supported; use "
                "rt-say <agent-or-instance> <kind> <body...>",
                file=sys.stderr,
            )
            raise SystemExit(2)


def validate_mail_kind(value):
    if not MAIL_KIND_RE.fullmatch(value):
        print(
            "rt-say: invalid kind: expected one non-empty token without "
            "whitespace, ']', or NUL",
            file=sys.stderr,
        )
        raise SystemExit(2)


def fsync_directory(path):
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def ensure_inbox_gitignore():
    """Atomically install the inbox-local ignore rule, repairing partial files."""
    ignore_path = INBOX_DIR / ".gitignore"
    tmp_path = INBOX_DIR / f".gitignore.tmp.{os.getpid()}.{time.time_ns()}"
    created_tmp = False
    try:
        descriptor = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        created_tmp = True
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as handle:
            handle.write("*\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_path, ignore_path)
        created_tmp = False
        fsync_directory(INBOX_DIR)
    except OSError:
        if created_tmp:
            try:
                tmp_path.unlink()
            except OSError:
                pass
        raise


def publish_maildir(target, msg_id, content, *, quiet_ack=False):
    """Publish one immutable maildir message via tmp -> new atomic rename."""
    validate_agent_component(target, "inbox target")
    filename = f"{'ack-' if quiet_ack else ''}{msg_id}.md"
    if Path(filename).name != filename or "/" in filename or "\x00" in filename:
        raise SystemExit(f"rt-say: invalid inbox message filename: {filename}")

    target_dir = INBOX_DIR / target
    tmp_dir = target_dir / "tmp"
    new_dir = target_dir / "new"
    cur_dir = target_dir / "cur"
    tmp_path = tmp_dir / filename
    new_path = new_dir / filename
    created_tmp = False
    try:
        for path in (tmp_dir, new_dir, cur_dir):
            path.mkdir(parents=True, exist_ok=True)
        ensure_inbox_gitignore()
        descriptor = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        created_tmp = True
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        if new_path.exists():
            raise FileExistsError(f"destination already exists: {new_path}")
        os.rename(tmp_path, new_path)
        created_tmp = False
        fsync_directory(new_dir)
    except OSError as error:
        if created_tmp:
            try:
                tmp_path.unlink()
            except OSError:
                pass
        raise SystemExit(f"rt-say: failed to publish inbox message {msg_id}: {error}") from error
    return new_path


def read_runtime(refresh=False):
    """Read runtime.json. Only refresh if explicitly requested or file is missing.

    Do NOT auto-refresh here — refreshing can shuffle the topology map between
    the caller's manual rt-refresh + rt-resolve and the actual send, causing
    the message to go to the wrong surface. The caller is responsible for
    ensuring the map is current (rt-refresh before rt-say).
    """
    if refresh or not RUNTIME.exists() or RUNTIME.stat().st_size == 0:
        run(str(TOOL_DIR / "rt-refresh"), stdout=subprocess.DEVNULL)
    runtime = json.loads(RUNTIME.read_text())
    if runtime.get("project") != str(ROOT):
        raise SystemExit(f"rt-say: runtime project mismatch: {runtime.get('project')} != {ROOT}")
    return runtime


def guard_route_in_runtime(runtime, route):
    runtime_workspace = runtime.get("workspace_ref")
    if route.get("workspace") != runtime_workspace:
        raise SystemExit(
            f"rt-say: refusing route outside current project runtime: route workspace={route.get('workspace')} runtime workspace={runtime_workspace}"
        )
    route_surface = route.get("surface")
    live_surfaces = {surface.get("surface_ref") for surface in runtime.get("surfaces") or []}
    agent_surfaces = {agent.get("surface_ref") for agent in (runtime.get("agents") or {}).values()}
    if route_surface not in (live_surfaces | agent_surfaces):
        raise SystemExit(f"rt-say: refusing route to surface not present in current project runtime: {route_surface}")


def infer_live_caller(runtime):
    caller_surface = ""
    try:
        identity = json.loads(
            subprocess.check_output(
                ("cmux", "identify", "--json"),
                text=True,
                stderr=subprocess.DEVNULL,
            )
        )
        caller = identity.get("caller") if isinstance(identity, dict) else None
        caller_surface = (
            caller.get("surface_ref") if isinstance(caller, dict) else ""
        ) or ""
    except (subprocess.CalledProcessError, OSError, json.JSONDecodeError):
        return ""
    for name, agent in (runtime.get("agents") or {}).items():
        if isinstance(agent, dict) and agent.get("surface_ref") == caller_surface:
            return name
    return ""


def infer_sender(runtime):
    sender = infer_live_caller(runtime)
    if sender:
        return sender
    # No match in current runtime — caller may be on a fresh surface.
    # Do NOT auto-refresh (same reasoning as read_runtime). Just return None
    # and let the caller set RT_FROM or run rt-refresh manually.
    return os.environ.get("RT_FROM", "")


def parse_resolve(agent):
    output = subprocess.check_output([str(TOOL_DIR / "rt-resolve"), agent], text=True).strip()
    result = {}
    for part in output.split():
        if "=" in part:
            key, value = part.split("=", 1)
            result[key] = value
    return result


def next_event_id(ledger, msg_id, lifecycle):
    count = 0
    if ledger.exists():
        with ledger.open() as fh:
            for line in fh:
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if record.get("msg_id") == msg_id and record.get("lifecycle") == lifecycle:
                    count += 1
    return f"{msg_id}:{lifecycle}:{count + 1}"


def append_ledger(sender, record):
    ledger = MSG_DIR / f"{sender}.jsonl"
    acquire_lock(LEDGER_LOCK, timeout=10.0)
    try:
        record = dict(record)
        record["event_id"] = next_event_id(ledger, record["msg_id"], record["lifecycle"])
        with ledger.open("a") as fh:
            fh.write(json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n")
    finally:
        release_lock(LEDGER_LOCK)


def append_ledger_after_delivery(sender, record):
    """Record mail delivery without changing the committed delivery result."""
    try:
        append_ledger(sender, record)
    # The atomic maildir rename is the delivery commit point. Ledger corruption
    # or lock failures after it must never turn a delivered message into a CLI
    # failure. Do not catch BaseException: interrupts still stop the process.
    except (Exception, SystemExit) as error:
        print(
            f"rt-say: warning: maildir delivery committed but ledger update failed: {error}",
            file=sys.stderr,
        )


def base_record(
    msg_id,
    sender,
    target,
    kind,
    body,
    rendered,
    send_text,
    route,
    submit,
    refs,
    lifecycle,
    source,
    correlation=None,
    *,
    origin_uuid=None,
    target_project_uuid=None,
):
    return {
        "schema": "roundtable.message_event.v1",
        "msg_id": msg_id,
        "event_id": "",
        "ts": utc_now(),
        "from": sender,
        "to": target,
        "kind": kind,
        "body": body,
        "rendered_text": rendered,
        "send_text": send_text,
        "workspace_ref": route.get("workspace"),
        "surface_ref": route.get("surface"),
        "pane_ref": route.get("pane"),
        "submit": submit or "none",
        "lifecycle": lifecycle,
        "refs": refs,
        "correlation": correlation or {},
        "source": source,
        "origin_uuid": origin_uuid,
        "target_project_uuid": target_project_uuid,
    }


def text_length(value):
    return len(value)


def terminal_single_line(value):
    return re.sub(r"\s+", " ", value).strip()


def submit_settle_delay(value):
    length = text_length(value)
    if length < 500:
        return 0.05
    if length < 1200:
        return 0.20
    if length < 2500:
        return 0.40
    return 0.75


def event_surface(frame):
    payload = frame.get("payload") or {}
    params = payload.get("params") or {}
    result = payload.get("result") or {}
    return (
        frame.get("surface_ref")
        or payload.get("surface_ref")
        or params.get("surface_ref")
        or result.get("surface_ref")
        or params.get("surface_id")
        or frame.get("surface_id")
        or payload.get("surface_id")
        or result.get("surface_id")
    )


def event_text_length(frame):
    payload = frame.get("payload") or {}
    params = payload.get("params") or {}
    for key in ("text_length", "length", "input_length"):
        if key in frame:
            return frame[key]
        if key in payload:
            return payload[key]
        if key in params:
            return params[key]
    return None


def wait_surface_input(proc, surface, expected_length, started_at):
    deadline = time.time() + 1.0
    try:
        while time.time() < deadline:
            readable, _, _ = select.select([proc.stdout], [], [], max(0.0, deadline - time.time()))
            if not readable:
                break
            line = proc.stdout.readline()
            if not line:
                break
            try:
                frame = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event_surface(frame) != surface:
                continue
            length = event_text_length(frame)
            if length is not None and int(length) != expected_length:
                continue
            occurred = frame.get("occurred_at")
            return {
                "surface_input_seq": frame.get("seq"),
                "surface_input_text_length": length,
                "surface_input_delta_ms": int((time.time() - started_at) * 1000),
                "surface_input_occurred_at": occurred,
            }
    finally:
        try:
            proc.terminate()
            proc.wait(timeout=0.2)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
    return {
        "surface_input_seq": None,
        "surface_input_text_length": None,
        "surface_input_delta_ms": None,
        "surface_input_timeout": True,
    }


BUSY_STATUSES = {"busy", "running", "in_tool", "waiting_permission"}
# agents.yaml submit value -> the key rt-say presses after sending text.
# "send_only" means no submit key (interrupt-safe); "steer" submits with Enter but
# the body is prefixed with /steer (see steer_prefix).
SUBMIT_KEY = {"enter": "Enter", "tab": "Tab", "send_only": "none", "steer": "Enter"}


def load_submit_config(root):
    """{agent_base: {idle, busy}} from agents.yaml submit blocks; default enter/enter."""
    try:
        doc = load_agents_doc(root, "rt-say")
    except SystemExit:
        doc = {}
    cfg = {}
    for base, agent in (doc.get("agents") or {}).items():
        submit = (agent or {}).get("submit") if isinstance(agent, dict) else None
        submit = submit or {}
        cfg[str(base).lower()] = {
            "idle": str(submit.get("idle") or "enter").lower(),
            "busy": str(submit.get("busy") or "enter").lower(),
        }
    return cfg


def submit_mode(target, status, submit_cfg):
    spec = submit_cfg.get(target) or {"idle": "enter", "busy": "enter"}
    return spec.get("busy", "enter") if status in BUSY_STATUSES else spec.get("idle", "enter")


def submit_policy(target, status, submit_cfg):
    return SUBMIT_KEY.get(submit_mode(target, status, submit_cfg), "Enter")


def steer_prefix(target, status, submit_cfg):
    """True when this agent's busy-submit is /steer and it isn't idle (non-interrupting inject)."""
    return (submit_cfg.get(target) or {}).get("busy") == "steer" and status != "idle"


def _prepare_legacy_context(args):
    """Resolve every child operation that may refresh runtime before locking."""

    global LEGACY_OPERATION_ACTIVE

    if "--legacy-nudge-only" not in args:
        return None
    reject_unsupported_message_options(args)
    if args.count("--fenced") > 1:
        print("rt-say: --fenced may be supplied only once", file=sys.stderr)
        raise SystemExit(2)
    if "--no-nudge" in args:
        print(
            "rt-say: --no-nudge and --legacy-nudge-only are mutually exclusive",
            file=sys.stderr,
        )
        raise SystemExit(2)
    positional = positional_args(args)
    if len(positional) < 2:
        usage()

    # From this point the caller explicitly requested an operational legacy
    # action, so preserve its uniform exit-3 failure contract.
    LEGACY_OPERATION_ACTIVE = True
    target, project_name = parse_target_address(positional[0])
    if project_name:
        raise SystemExit(
            "rt-say: cross-worktree addressing is maildir-only and cannot "
            "use --legacy-nudge-only"
        )
    runtime = read_runtime()
    route = parse_resolve(target)
    runtime = read_runtime()
    guard_route_in_runtime(runtime, route)
    return {"runtime": runtime, "route": route}


def _main_locked(fenced_agent, legacy_context, address):
    global LEGACY_OPERATION_ACTIVE

    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print_help()
        return None, None

    reject_unsupported_message_options(args)

    verbose = False
    if "--verbose" in args:
        verbose = True
        args = [arg for arg in args if arg != "--verbose"]
    fenced = "--fenced" in args
    if args.count("--fenced") > 1:
        print("rt-say: --fenced may be supplied only once", file=sys.stderr)
        raise SystemExit(2)
    explicit_no_nudge = "--no-nudge" in args
    legacy_nudge_only = "--legacy-nudge-only" in args
    if explicit_no_nudge and legacy_nudge_only:
        print("rt-say: --no-nudge and --legacy-nudge-only are mutually exclusive", file=sys.stderr)
        raise SystemExit(2)
    if fenced and not explicit_no_nudge:
        print("rt-say: --fenced requires --no-nudge", file=sys.stderr)
        raise SystemExit(2)
    args = [
        arg
        for arg in args
        if arg not in {"--fenced", "--no-nudge", "--legacy-nudge-only"}
    ]
    if len(args) < 2:
        usage()
    target, project_name = parse_target_address(args[0])
    if project_name and address.target_name != project_name:
        raise SystemExit(
            "rt-say: project address changed during delivery preparation"
        )
    kind = args[1]
    body_arg = " ".join(args[2:])
    validate_mail_kind(kind)
    ack_mode = os.environ.get("RT_ACK_MODE") == "1"
    if kind == "sync-ack" and not ack_mode:
        raise SystemExit("rt-say: sync-ack is reserved for rt-ack; use rt-ack <msg_id>[,<msg_id>...] [body]")
    if len(args) < 3 and not ack_mode:
        usage()

    maildir_only = not legacy_nudge_only
    if legacy_nudge_only:
        # Syntax errors above retain their ordinary usage status. Once an
        # explicitly requested legacy operation begins, every operational
        # failure is reported uniformly by the top-level handler.
        LEGACY_OPERATION_ACTIVE = True

    STATE_DIR.mkdir(exist_ok=True)
    LOCK_DIR.mkdir(exist_ok=True)
    MSG_DIR.mkdir(exist_ok=True)

    explicit_sender = os.environ.get("RT_FROM", "").lower()
    if explicit_sender:
        validate_agent_component(explicit_sender, "sender")
    if maildir_only:
        target_agent, target_instance = configured_target(
            address.target_root,
            target,
        )
        # Identity belongs to the harness adapter, not the terminal emulator.
        # Launchers inject RT_FROM; Codex app-server turns expose
        # CODEX_THREAD_ID. The compatibility --no-nudge flag is intentionally
        # identical to the normal maildir path.
        sender = fenced_agent or explicit_sender or infer_sender_from_harness_env(ROOT)
    else:
        runtime = legacy_context["runtime"]
        # Preserve WP1 caller authority: a live cmux caller wins over all
        # inherited environment. The app-server fallback is consulted only
        # when neither the caller nor explicit RT_FROM identifies a sender.
        sender = infer_sender(runtime) or infer_sender_from_harness_env(ROOT)
        target_agent, target_instance = configured_target(
            ROOT,
            target,
            required=False,
            runtime=runtime,
        )
    if not sender:
        raise SystemExit("rt-say: could not infer sender; set RT_FROM")
    sender = str(sender).lower()
    validate_agent_component(sender, "sender")
    if maildir_only:
        _sender_agent, sender_instance = configured_target(ROOT, sender)
        is_self_send = (
            address.origin_uuid == address.target_uuid
            and sender_instance == target_instance
        )
    else:
        is_self_send = sender in {target_agent, target_instance}
    if is_self_send and os.environ.get("RT_ALLOW_SELF_SEND", "0") != "1":
        raise SystemExit(
            f"rt-say: refusing self-send from {sender} to {target}; "
            "self-send is disabled by default (set RT_ALLOW_SELF_SEND=1 "
            "only for controlled tests)"
        )

    # A base agent with exactly one configured instance is an address alias,
    # not a mailbox or ledger identity. Durable identity must use concrete
    # instances or an accepted send/ack can land where no configured seat
    # consumes it.
    durable_sender = sender_instance if maildir_only else sender
    durable_target = target_instance if maildir_only else target

    refs = [ref for ref in os.environ.get("RT_ACK_REFS", "").split(",") if ref] if ack_mode else []
    if kind == "sync-ack" and not refs:
        for part in body_arg.split():
            if part.startswith("refs="):
                refs = [ref for ref in part.removeprefix("refs=").split(",") if ref]
                break
    body = os.environ.get("RT_ACK_BODY") if ack_mode else body_arg
    if ack_mode and body == "":
        body = None
    if ack_mode and kind == "sync-ack":
        if not refs:
            raise SystemExit(
                "rt-say: acknowledgement requires at least one ref"
            )
        if body and any(part.startswith("refs=") for part in body.split()):
            raise SystemExit(
                "rt-say: acknowledgement body must not contain a refs token"
            )
        # RT_ACK_REFS is the validated lifecycle authority. Render the durable
        # body from it instead of trusting a second argv copy that could name a
        # different message.
        body_arg = f"refs={','.join(refs)}"
        if body:
            body_arg = f"{body_arg} {body}"

    msg_id = (
        f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-"
        f"{durable_sender}-to-{durable_target}-{os.getpid()}"
    )
    cross_project = address.origin_uuid != address.target_uuid
    mail_text = format_mail_envelope(
        durable_sender,
        durable_target,
        kind,
        msg_id,
        body_arg,
        origin_uuid=address.origin_uuid,
    )
    rendered = mail_text

    if maildir_only:
        publish_maildir(
            durable_target,
            msg_id,
            mail_text,
            quiet_ack=kind == "sync-ack",
        )
        warn_if_target_not_active(address.target_root, durable_target)

    if maildir_only:
        route = {"workspace": None, "surface": None, "pane": None}
        submit = "none"
        send_text = terminal_single_line(rendered)
        pending = base_record(
            msg_id,
            durable_sender,
            durable_target,
            kind,
            body,
            rendered,
            send_text,
            route,
            submit,
            refs,
            "pending",
            "rt-say",
            origin_uuid=address.origin_uuid,
            target_project_uuid=address.target_uuid,
        )
        deferred_ledger = None
        if cross_project:
            deferred_ledger = (durable_sender, pending)
        else:
            append_ledger_after_delivery(durable_sender, pending)
        if verbose:
            return (
                f"sent id={msg_id} from={durable_sender} "
                f"to={durable_target} "
                "delivery=maildir submit=none",
                deferred_ledger,
            )
        return f"sent maildir-only {msg_id}", deferred_ledger

    # Everything below is the explicit, keyboard-only legacy path. It never
    # publishes maildir state; failures are therefore independent of delivery.
    runtime = legacy_context["runtime"]
    route = legacy_context["route"]
    resolved_target_agent = route.get("agent", target)
    if resolved_target_agent != target_agent:
        raise SystemExit(
            f"rt-say: configured target '{target}' resolved as unexpected agent "
            f"'{resolved_target_agent}'"
        )
    resolved_target_instance = route.get("instance", target)
    if (
        sender in {resolved_target_agent, resolved_target_instance}
        and os.environ.get("RT_ALLOW_SELF_SEND", "0") != "1"
    ):
        raise SystemExit(
            f"rt-say: refusing self-send from {sender} to {target}; "
            "self-send is disabled by default (set RT_ALLOW_SELF_SEND=1 "
            "only for controlled tests)"
        )
    # Verify the resolved surface actually belongs to the target agent.
    # Multi-instance: rt-resolve reports agent=<base>, but runtime keys by
    # instance id (e.g. codex#1, codex-build). Accept both base and instance.
    route_surface = route.get("surface")
    resolved_names = {resolved_target_agent, route.get("instance"), target}
    agents = runtime.get("agents") or {}
    for name, agent_data in agents.items():
        if agent_data.get("surface_ref") == route_surface and name not in resolved_names:
            raise SystemExit(
                f"rt-say: route mismatch — target '{target}' resolved to surface {route_surface} "
                f"but that surface belongs to agent '{name}'. Run rt-refresh then rt-resolve {target} to fix."
            )
    status = route.get("status", "unknown")
    submit_cfg = load_submit_config(ROOT)
    submit = submit_policy(target_agent, status, submit_cfg)
    send_text = terminal_single_line(rendered)
    if steer_prefix(target_agent, status, submit_cfg):
        send_text = f"/steer {send_text}"

    send_lock = LOCK_DIR / f"send-{target}.lock"
    acquire_lock(send_lock)
    try:
        meta = {
            "pid": os.getpid(),
            "from": sender,
            "to": target,
            "created_at": utc_now(),
            "msg_id": msg_id,
        }
        (send_lock / "meta.json").write_text(json.dumps(meta, ensure_ascii=False) + "\n")

        pending = base_record(
            msg_id,
            sender,
            target,
            kind,
            body,
            rendered,
            send_text,
            route,
            submit,
            refs,
            "pending",
            "rt-say",
            origin_uuid=address.origin_uuid,
            target_project_uuid=address.target_uuid,
        )
        append_ledger(sender, pending)

        watcher = subprocess.Popen(
            [
                "cmux",
                "events",
                "--category",
                "surface",
                "--name",
                "surface.input_sent",
                "--no-ack",
                "--no-heartbeat",
                "--limit",
                "10",
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        started_at = time.time()
        try:
            run("cmux", "send", "--workspace", route["workspace"], "--surface", route["surface"], send_text, stdout=subprocess.DEVNULL)
            correlation = wait_surface_input(watcher, route["surface"], text_length(send_text), started_at)
        finally:
            if watcher.poll() is None:
                try:
                    watcher.terminate()
                    watcher.wait(timeout=0.2)
                except Exception:
                    try:
                        watcher.kill()
                    except Exception:
                        pass
        injected = base_record(
            msg_id,
            sender,
            target,
            kind,
            body,
            rendered,
            send_text,
            route,
            submit,
            refs,
            "injected",
            "rt-say",
            correlation,
            origin_uuid=address.origin_uuid,
            target_project_uuid=address.target_uuid,
        )
        append_ledger(sender, injected)

        if submit != "none":
            settle_delay = submit_settle_delay(send_text)
            time.sleep(settle_delay)
            correlation["submit_settle_delay_ms"] = int(settle_delay * 1000)
            run("cmux", "send-key", "--workspace", route["workspace"], "--surface", route["surface"], submit, stdout=subprocess.DEVNULL)
        submitted = base_record(
            msg_id,
            sender,
            target,
            kind,
            body,
            rendered,
            send_text,
            route,
            submit,
            refs,
            "submitted",
            "rt-say",
            correlation,
            origin_uuid=address.origin_uuid,
            target_project_uuid=address.target_uuid,
        )
        append_ledger(sender, submitted)
    finally:
        release_lock(send_lock)

    if verbose:
        return (
            f"sent id={msg_id} from={sender} to={target} "
            f"workspace={route['workspace']} surface={route['surface']} "
            f"submit={submit}",
            None,
        )
    return f"sent {msg_id}", None


def main():
    global LOCK_DIR, MSG_DIR, INBOX_DIR, LEDGER_LOCK

    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print_help()
        return
    fenced_count = args.count("--fenced")
    if fenced_count > 1:
        print("rt-say: --fenced may be supplied only once", file=sys.stderr)
        raise SystemExit(2)
    fenced = fenced_count == 1
    if fenced and "--no-nudge" not in args:
        print("rt-say: --fenced requires --no-nudge", file=sys.stderr)
        raise SystemExit(2)
    reject_unsupported_message_options(args)
    if "--no-nudge" in args and "--legacy-nudge-only" in args:
        print(
            "rt-say: --no-nudge and --legacy-nudge-only are mutually exclusive",
            file=sys.stderr,
        )
        raise SystemExit(2)
    # Fence validation uses host-runtime locks. Complete it before taking the
    # target registry or mailbox lock. It always authenticates the sender
    # project, never the independently authorized target.
    fenced_agent = authenticate_fenced_sender(ROOT, "rt-say") if fenced else ""
    _target, requested_address = requested_project_address(args)
    legacy_context = _prepare_legacy_context(args)
    target_root = (
        requested_address.target_root if requested_address is not None else ROOT
    )
    with locked_project_mailbox(target_root, tool="rt-say") as mailbox:
        if (
            requested_address is not None
            and mailbox.project_uuid != requested_address.target_uuid
        ):
            raise SystemExit(
                "rt-say: address target changed before delivery: "
                f"expected {requested_address.target_uuid}, "
                f"resolved {mailbox.project_uuid}"
            )
        address = requested_address or ProjectAddress(
            origin_uuid=mailbox.project_uuid,
            origin_root=ROOT,
            origin_group="",
            target_uuid=mailbox.project_uuid,
            target_root=ROOT,
            target_name=ROOT.name,
        )
        LOCK_DIR = mailbox.locks_dir
        MSG_DIR = mailbox.messages_dir
        INBOX_DIR = mailbox.inbox_dir
        LEDGER_LOCK = LOCK_DIR / "ledger.lock"
        output, deferred_ledger = _main_locked(
            fenced_agent,
            legacy_context,
            address,
        )

    if deferred_ledger is not None:
        sender, pending = deferred_ledger
        try:
            # Delivery committed in the target UUID mailbox. Record the
            # outbound event under the origin UUID in a fresh, non-nested
            # layout section so A→B and B→A cannot form a lock cycle.
            with locked_project_mailbox(ROOT, tool="rt-say") as origin_mailbox:
                if origin_mailbox.project_uuid != address.origin_uuid:
                    raise SystemExit(
                        "rt-say: origin project changed after delivery: "
                        f"expected {address.origin_uuid}, "
                        f"resolved {origin_mailbox.project_uuid}"
                    )
                LOCK_DIR = origin_mailbox.locks_dir
                MSG_DIR = origin_mailbox.messages_dir
                INBOX_DIR = origin_mailbox.inbox_dir
                LOCK_DIR.mkdir(exist_ok=True)
                MSG_DIR.mkdir(exist_ok=True)
                LEDGER_LOCK = LOCK_DIR / "ledger.lock"
                append_ledger_after_delivery(sender, pending)
        except (Exception, SystemExit) as error:
            print(
                "rt-say: warning: maildir delivery committed but ledger "
                f"update failed: {error}",
                file=sys.stderr,
            )
    if output:
        print(output)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        if LEGACY_OPERATION_ACTIVE:
            command = error.cmd if isinstance(error.cmd, str) else " ".join(error.cmd)
            print(
                f"rt-say: legacy nudge failed with exit {error.returncode}: {command}",
                file=sys.stderr,
            )
            raise SystemExit(LEGACY_FAILURE_EXIT) from None
        raise
    except SystemExit as error:
        if not LEGACY_OPERATION_ACTIVE:
            raise
        detail = terminal_single_line(str(error.code)) or "unknown failure"
        print(f"rt-say: legacy nudge failed: {detail}", file=sys.stderr)
        raise SystemExit(LEGACY_FAILURE_EXIT) from None
    except OSError as error:
        if LEGACY_OPERATION_ACTIVE:
            detail = terminal_single_line(str(error)) or error.__class__.__name__
            print(f"rt-say: legacy nudge failed: {detail}", file=sys.stderr)
            raise SystemExit(LEGACY_FAILURE_EXIT) from None
        mailbox_detail = (
            f" while writing mailbox {INBOX_DIR}" if INBOX_DIR is not None else ""
        )
        raise SystemExit(
            f"rt-say: command failed{mailbox_detail}: {error}"
        ) from None
    except Exception as error:
        if not LEGACY_OPERATION_ACTIVE:
            raise
        detail = terminal_single_line(str(error)) or error.__class__.__name__
        print(f"rt-say: legacy nudge failed: {detail}", file=sys.stderr)
        raise SystemExit(LEGACY_FAILURE_EXIT) from None
