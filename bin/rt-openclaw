#!/usr/bin/env python3
"""Refuse the retired OpenClaw seat while retaining its lab entry point."""

from __future__ import annotations

import sys


def main() -> int:
    print(
        "rt-openclaw: the 2026-08-17 owner decision removed OpenClaw from "
        "pneu's shipped seat surface because the current Gateway integration "
        "exposes no interactive human surface. The retained internal lab "
        "machinery remains directly invocable as `rt-openclaw-wake`.",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
